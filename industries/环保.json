,"is_core":true,"scope":"industry","node_type":"logic"},{"id":"log_66a6d734e0c2f070","logic_id":"66a6d734e0c2f070","type":"趋势","premise":"行业趋势显示物业碳中和转型需经历三个阶段，核心驱动力从数据驱动演进为技术驱动再到生态驱动，管理范围从企业碳扩展至城市碳","conclusion":"物业碳中和转型路径需分阶段推进，每个阶段有明确的核心理念和关键任务","text":"从行业趋势显示物业碳中和转型需经历三个阶段，核心驱动力从数据驱的趋势分析,判断物业碳中和转型路径需分阶段推进，每个阶段有明确的核心理念和关","dimension":"2","confidence":0.92,"is_core":true,"scope":"industry","node_type":"logic"},{"id":"log_f2a05d7495fb37d2","logic_id":"f2a05d7495fb37d2","type":"对比","premise":"行业产业格局显示物业行业范围一（15%-20%）、范围二（60%-70%）、范围三（10%-25%）的排放结构差异显著，各范围排放源的可控性和减排难度不同","conclusion":"物业碳减排应分范围制定差异化策略，范围二（占比最高）应作为首要攻坚重点","text":"通过对比行业产业格局显示物业行业范围一（15%-20%）、范围二（6,得出物业碳减排应分范围制定差异化策略，范围二（占比最高）应作为首","dimension":"2","confidence":0.9,"is_core":false,"scope":"industry","node_type":"logic"},{"id":"log_f943e344a44764a6","logic_id":"f943e344a44764a6","type":"趋势","premise":"行业趋势显示范围三包含15类排放，物业企业数据基础和能力有限，应根据重要性原则和数据可行性选择性纳入","conclusion":"范围三管理应采取务实聚焦策略，从高占比、高可行性的3类排放起步","text":"从行业趋势显示范围三包含15类排放，物业企业数据基础和能力有限的趋势分析,判断范围三管理应采取务实聚焦策略，从高占比、高可行性的3类排放起","dimension":"2","confidence":0.87,"is_core":false,"scope":"industry","node_type":"logic"}],"_indicators":[],"_frameworks":[{"id":"fw_fw_9a95768cb511","name":"物业碳排放三范围全景核算框架","type":"core_architecture","category":"行业分析","industry":"物业管理","steps":"[\"\\u754c\\u5b9a\\u7ec4\\u7ec7\\u8fb9\\u754c\\uff1a\\u91c7\\u7528\\u8fd0\\u8425\\u63a7\\u5236\\u6743\\u6cd5\\uff0c\\u660e\\u786e\\u7269\\u4e1a\\u516c\\u53f8\\u62e5\\u6709\\u6216\\u63a7\\u5236\\u7684\\u6392\\u653e\\u6e90\\u8303\\u56f4\", \"\\u5212\\u5206\\u8fd0\\u8425\\u8fb9\\u754c\\uff1a\\u6309GHG Protocol\\u4e09\\u8303\\u56f4\\u5206\\u7c7b\\uff0c\\u8303\\u56f4\\u4e00/\\u4e8c\\u5168\\u9762\\u8986\\u76d6\\uff0c\\u8303\\u56f4\\u4e09\\u805a\\u7126\\u9ad8\\u91cd\\u8981\\u6027\\u9879\\uff08S3-A\\u91c7\\u8d2d\\u3001S3-B\\u80fd\\u6e90\\u4e0a\\u6e38\\u3001S3-C\\u5546\\u52a1\\u65c5\\u884c\\uff09\", \"\\u8bc6\\u522b\\u6392\\u653e\\u6e90\\uff1a\\u5efa\\u7acb\\u6392\\u653e\\u6e90\\u7f16\\u7801\\u4f53\\u7cfb\\uff08S1-A-01\\u5929\\u7136\\u6c14\\u71c3\\u70e7\\u81f3S3-C-02\\u5546\\u52a1\\u65c5\\u884c\\u4f4f\\u5bbf\\uff09\\uff0c\\u660e\\u786e\\u6d3b\\u52a8\\u6570\\u636e\\u3001\\u6392\\u653e\\u56e0\\u5b50\\u3001\\u6570\\u636e\\u6765\\u6e90\", \"\\u5efa\\u7acb\\u8d23\\u4efb\\u77e9\\u9635\\uff1a\\u533a\\u5206\\u7269\\u4e1a\\u5168\\u8d23\\u4e0e\\u95f4\\u63a5\\u8d23\\u4efb\\uff0c\\u8303\\u56f4\\u4e00/\\u4e8c\\u7531\\u7269\\u4e1a\\u627f\\u62c5\\uff0c\\u8303\\u56f4\\u4e09\\u901a\\u8fc7\\u5408\\u540c/\\u4f9b\\u5e94\\u5546\\u8c03\\u67e5\\u83b7\\u53d6\\u6570\\u636e\", \"\\u6301\\u7eed\\u8fed\\u4ee3\\uff1a\\u9075\\u5faa\\u91cd\\u8981\\u6027\\u539f\\u5219\\u548c\\u6570\\u636e\\u53ef\\u884c\\u6027\\uff0c\\u4ece\\u805a\\u7126\\u9879\\u9010\\u6b65\\u6269\\u5c55\\u81f3\\u5168\\u90e815\\u7c7b\\u8303\\u56f4\\u4e09\\u6392\\u653e\"]","confidence":0.8,"content":"框架名称：物业碳排放三范围全景核算框架\n描述：基于GHG Protocol标准框架，建立物业行业专属的三范围碳排放核算体系。范围一聚焦直接排放（天然气/汽油/柴油燃烧），范围二聚焦外购能源间接排放（电力/热力消耗，尤其公区照明/电梯/水泵），范围三聚焦价值链排放（采购商品/服务、能源上游、商务旅行）。通过运营控制权法界定组织边界，物理边界限定项目红线内设施，责任归属明确物业全责或间接责任。\n适用场景：物业企业碳排放核算体系建设与行业标准制定参考\n核心维度：物理边界、运营边界、责任归属、数据来源\n步骤：界定组织边界：采用运营控制权法，明确物业公司拥有或控制的排放源范围, 划分运营边界：按GHG Protocol三范围分类，范围一/二全面覆盖，范围三聚焦高重要性项（S3-A采购、S3-B能源上游、S3-C商务旅行）, 识别排放源：建立排放源编码体系（S1-A-01天然气燃烧至S3-C-02商务旅行住宿），明确活动数据、排放因子、数据来源, 建立责任矩阵：区分物业全责与间接责任，范围一/二由物业承担，范围三通过合同/供应商调查获取数据, 持续迭代：遵循重要性原则和数据可行性，从聚焦项逐步扩展","is_core":true,"node_type":"framework"},{"id":"fw_fw_27ee074affac","name":"物业岗位碳排放责任矩阵","type":"methodology","category":"公司分析","industry":"物业管理","steps":"[\"\\u8bc6\\u522b\\u5173\\u952e\\u6392\\u653e\\u573a\\u666f\\uff1a\\u6309\\u5c97\\u4f4d\\u68b3\\u7406\\u4e3b\\u8981\\u78b3\\u6392\\u653e\\u6e90\\uff08\\u8bbe\\u5907\\u8fd0\\u884c\\u3001\\u71c3\\u6cb9\\u6d88\\u8017\\u3001\\u529e\\u516c\\u7528\\u7535\\u3001\\u5dee\\u65c5\\u4ea4\\u901a\\uff09\", \"\\u5236\\u5b9a\\u63a7\\u78b3\\u63aa\\u65bd\\uff1a\\u9488\\u5bf9\\u5404\\u5c97\\u4f4d\\u6392\\u653e\\u7279\\u70b9\\u63d0\\u51fa\\u5177\\u4f53\\u51cf\\u6392\\u884c\\u52a8\\uff08\\u667a\\u80fd\\u7535\\u8868\\u5206\\u9879\\u8ba1\\u91cf\\u3001\\u7535\\u52a8\\u8bbe\\u5907\\u66ff\\u6362\\u3001\\u65e0\\u7eb8\\u5316\\u6d41\\u7a0b\\u3001\\u4f1a\\u8bae\\u78b3\\u8db3\\u8ff9\\u6838\\u7b97\\uff09\", \"\\u5efa\\u7acb\\u4e3b\\u4f4e\\u78b3\\u884c\\u4e3a\\u89c4\\u8303\\uff1a\\u5c06\\u51cf\\u6392\\u63aa\\u65bd\\u8f6c\\u5316\\u4e3a\\u65e5\\u5e38\\u884c\\u4e3a\\u51c6\\u5219\\uff0c\\u5f62\\u6210\\u53ef\\u6267\\u884c\\u7684\\u5c97\\u4f4d\\u78b3\\u7ba1\\u7406\\u6307\\u5f15\", \"\\u914d\\u5957\\u80fd\\u529b\\u5efa\\u8bbe\\uff1a\\u660e\\u786e\\u5c97\\u4f4d\\u6838\\u5fc3\\u6280\\u80fd\\u8981\\u6c42\\u548c\\u57f9\\u8bad\\u8ba4\\u8bc1\\u6807\\u51c6\\uff0c\\u786e\\u4fdd\\u78b3\\u7ba1\\u7406\\u80fd\\u529b\\u5230\\u4f4d\"]","confidence":0.8,"content":"框架名称：物业岗位碳排放责任矩阵\n描述：将碳排放指标分解至物业各岗位一线员工，建立岗位碳排放及控制地图。工程维护岗负责设备房运行（水泵/空调/电梯能耗）、制冷剂加注；环境管理岗负责绿化机械燃油消耗、垃圾清运车辆；秩序巡逻岗负责巡逻车充电、岗亭取暖制冷；客户服务岗负责纸质工单打印、办公设备待机；管理层负责差旅交通、数据中心运行。配套岗位技能要求（能效诊断、数据采集、SPC方法）和培训认证标准（ISO14064-3、CEM、六西格玛绿带）。\n适用场景：物业公司碳管理能力建设与岗位责任落实\n核心维度：岗位角色、排放场景、控碳措施、低碳行为\n步骤：识别关键排放场景：按岗位梳理主要碳排放源（设备运行、燃油消耗、办公用电、差旅交通）, 制定控碳措施：针对各岗位排放特点提出具体减排行动（智能电表分项计量、电动设备替换、无纸化流程、会议碳足迹核算）, 建立主低碳行为规范：将减排措施转化为日常行为准则，形成可执行的岗位碳管理指引, 配套能力建设：明确岗位核心技能要求和培训认证标准，确保碳管理能力到位","is_core":true,"node_type":"framework"}],"_relatedEntities":[{"id":"ent_57aa2e3e6cae","name":"虚拟电厂","type":"TECH","relations":["对比"],"relation_count":1,"description":"碳汇监测卫星图谱用于监测社区碳汇效果，虚拟电厂参与城市电网负荷调节，两者共同支撑年减碳贡献占城市总量8%的目标","dir":"out","descriptions":["碳汇监测卫星图谱用于监测社区碳汇效果，虚拟电厂参与城市电网负荷调节，两者共同支撑年减碳贡献占城市总量8%的目标"]}],"_reports":[{"report_id":"rpt_c757e70ef4a6","title":"中国物业行业碳中和战略与路径报告_19页_16mb","source":"券商研报","publish_date":"2024-12-15","industry":"物业管理/绿色建筑"}]},{"id":"ent_0ab13923b3ce","name":"粤丰","type":"ORG","industry":"环保","desc":"粤丰：cn\n 建议关注：绿色动力环保，大禹节水，联泰环保，旺能环境，北控水务集团，武汉控股，碧水\n源，重庆水务，凯美特气，仕净科技，浙富控股。\n行业走势\n 垃圾焚烧25H1总结：降本增效提ROE&现金流改善提分红持续兑现。【瀚蓝环境】内生&并\n购成长超预期，首次派发中期股息。25H1归母净利润润9.67亿元，剔除上年同期一次性收益后\n环保 沪深300\n同比+28%，主要系①粤丰6月净利润润1.17亿。","is_core":false,"node_type":"entity","typeLabel":"ORG",