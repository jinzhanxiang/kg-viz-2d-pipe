07\\u7ea6\\u675f\\uff0c\\u4e2d\\u7f8e\\u6b272035\\u5e74\\u78b3\\u6392\\u653e\\u76ee\\u6807\\u660e\\u786e\", \"\\u7b2c\\u4e8c\\u6b65\\uff1a\\u63a8\\u5bfc\\u98ce\\u5149\\u50a8\\u5e74\\u65b0\\u589e\\u88c5\\u673a\\u5cf0\\u503c\\u51fa\\u73b0\\u57282035\\u5e74\\u5de6\\u53f3\", \"\\u7b2c\\u4e09\\u6b65\\uff1a\\u6d4b\\u7b97\\u50a8\\u80fd\\u88c5\\u673a\\u5929\\u82b1\\u677f\\u500d\\u6570\\u548c\\u51fa\\u8d27\\u91cf\\u5cf0\\u503c\", \"\\u7b2c\\u56db\\u6b65\\uff1a\\u8ba1\\u7b972024-2035\\u5e74CAGR\\u9a8c\\u8bc1\\u589e\\u957f\\u786e\\u5b9a\\u6027\"]","confidence":0.8,"content":"框架名称：储能长期空间测算框架\n描述：基于巴黎协定NDCs框架和双碳目标，从终局思维出发，通过能源转型→双碳目标→风光需求→储能需求的逻辑链条测算长期空间。\n适用场景：储能市场规模预测、长期空间判断\n核心维度：NDCs目标|风光装机|储能需求|CAGR\n步骤：第一步：确定巴黎协定NDCs目标约束，中美欧2035年碳排放目标明确, 第二步：推导风光储年新增装机峰值出现在2035年左右, 第三步：测算储能装机天花板倍数和出货量峰值, 第四步：计算2024-2035年CAGR验证增长确定性","is_core":true,"node_type":"framework"}],"_relatedEntities":[{"id":"ent_e9a8ffc87a86","name":"中国储能市场","type":"INDUSTRY","relations":["监管","合作"],"relation_count":2,"description":"巴黎协定推动中美欧能源转型，中国风光渗透率从11.6%升至42%，带动储能需求","dir":"out","descriptions":["巴黎协定推动中美欧能源转型，中国风光渗透率从11.6%升至42%，带动储能需求","巴黎协定推动碳中和目标，中国风光渗透率从11.6%升至42%带动储能需求"]},{"id":"ent_9deed5bb0dad","name":"欧洲储能市场","type":"INDUSTRY","relations":["监管","合作"],"relation_count":2,"description":"欧洲风光渗透率从24.9%升至45.8%，欧洲储能市场受益于最激进的气候政策","dir":"out","descriptions":["欧洲风光渗透率从24.9%升至45.8%，欧洲储能市场受益于最激进的气候政策","欧洲最早响应巴黎协定，2024年风光渗透率达45.8%引领全球储能市场"]},{"id":"ent_1301f78691c8","name":"美国储能市场","type":"INDUSTRY","relations":["监管","合作"],"relation_count":2,"description":"美国响应巴黎协定推动能源转型，2024年风光渗透率达25.8%促进储能发展","dir":"out","descriptions":["美国风光渗透率从9.1%升至25.8%，储能作为新能源配套受巴黎协定影响","美国响应巴黎协定推动能源转型，2024年风光渗透率达25.8%促进储能发展"]},{"id":"ent_b085bb727634","name":"欧洲","type":"PLACE","relations":["监管"],"relation_count":1,"description":"欧洲在《巴黎协定》框架下风光渗透率从2015年24.9%增长至2024年45.8%，是全球能源转型最快的地区之一，意大利、英国等国出台储能创新机制","dir":"out","descriptions":["欧洲在《巴黎协定》框架下风光渗透率从2015年24.9%增长至2024年45.8%，是全球能源转型最快的地区之一，意大利、英国等国出台储能创新机制"]},{"id":"ent_6422c343c99d","name":