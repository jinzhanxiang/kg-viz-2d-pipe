u674e\\u5bb6\\u6c9f\\u3001\\u65b0\\u7586\\u5927\\u7ea2\\u67f3\\u6ee9\\u6295\\u4ea7\", \"\\u56fd\\u5185\\u76d0\\u6e56\\u677f\\u5757\\u5206\\u6790\\uff1a\\u9752\\u6d77\\u5bdf\\u5c14\\u6c57\\u76d0\\u6e56\\u5404\\u4f01\\u4e1a\\u3001\\u897f\\u85cf\\u5404\\u76d0\\u6e56\\u9879\\u76ee\\u89c4\\u5212\\u548c\\u5728\\u5efa\\u8fdb\\u5ea6\", \"\\u56de\\u6536\\u677f\\u5757\\u5206\\u6790\\uff1a\\u5e9f\\u6599\\u56de\\u6536\\u4ea7\\u80fd\\u589e\\u957f\\u5bf9\\u4f9b\\u7ed9\\u7684\\u8865\\u5145\\u4f5c\\u7528\"]","confidence":0.8,"content":"框架名称：全球锂资源供给六分法\n描述：将全球锂资源供给来源分为六大板块进行详细分析和预测：海外盐湖（阿根廷、智利）、澳矿、非洲锂矿、南美其他、 国内锂矿（江西宜春、四川、新疆）、国内盐湖（青海、西藏），评估各板块的增量释放节奏和贡献度\n核心维度：海外盐湖, 澳矿, 非洲锂矿, 国内锂矿, 国内盐湖, 回收\n步骤：海外盐湖板块分析：阿根廷新建项目爬坡进度、智利SQM和雅保扩产计划、巴西项目, 澳矿板块分析：Greenbushes、Pilgangoora等主要矿山增量预测、停产矿山影响, 非洲锂矿板块分析：中资企业在非项目投产进度、津巴布韦和尼日利亚进口数据, 国内锂矿板块分析：江西矿证扰动、四川甲基卡和李家沟、新疆大红柳滩投产, 国内盐湖板块分析：青海察尔汗盐湖各企业、西藏各盐湖项目规划和在建进度, 回收板块分析：废料回收产能增长对供给的补充作用","is_core":true,"node_type":"framework"}],"_relatedEntities":[{"id":"ent_4ceac5326ad0","name":"瀚蓝环境","type":"ORG","relations":["对比"],"relation_count":1,"description":"海峡环保与瀚蓝环境均为固废处理企业，瀚蓝环境分红比例21.08%显著高于海峡环保的15.15%，反映盈利质量差异","dir":"out","descriptions":["海峡环保与瀚蓝环境均为固废处理企业，瀚蓝环境分红比例21.08%显著高于海峡环保的15.15%，反映盈利质量差异"]},{"id":"ent_574ca1234b7c","name":"江南水务","type":"ORG","relations":["对比"],"relation_count":1,"description":"江南水务与海峡环保同属水务行业，江南水务分红比例15.15%与海峡环保持平，但江南水务未分配利润达17.4亿元","dir":"in","descriptions":["江南水务与海峡环保同属水务行业，江南水务分红比例15.15%与海峡环保持平，但江南水务未分配利润达17.4亿元"]},{"id":"ent_7e7c2a0c4eed","name":"上海环境","type":"ORG","relations":["对比"],"relation_count":1,"description":"上海环境与海峡环保同属环保行业，上海环境分红比例21.08%高于海峡环保的15.15%，反映盈利稳定性差异","dir":"in","descriptions":["上海环境与海峡环保同属环保行业，上海环境分红比例21.08%高于海峡环保的15.15%，反映盈利稳定性差异"]}],"_reports":[{"report_id":"rpt_e7c933490657","title":"20250902-东吴证券-环保行业跟踪周报_固废提质增效_现金流改善逻辑持续兑现_加强全国碳市场建设碳约束趋严_32页_2mb","source":"券商研报","publish_date":"2025-09-02","industry":"有色金属/锂"}]},{"id":"ent_8cccf07d84b8","name":"海螺创业","type":"ORG","industry":"环保","desc":"海螺创业在2025年上半年实现归母净利润12