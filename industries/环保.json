\\u89e3\\u6a21\\u578b\\uff0c\\u6309\\u5e94\\u7528\\u9886\\u57df\\u7edf\\u8ba1\\u9502\\u79bb\\u5b50\\u7535\\u6c60\\u548c\\u4f20\\u7edf\\u884c\\u4e1a\\u7684\\u78b3\\u9178\\u9502\\u9700\\u6c42\\u9884\\u6d4b\", \"\\u5f15\\u5165\\u4ea7\\u4e1a\\u94fe2-4\\u5468\\u5907\\u8d27\\u5e93\\u5b58\\u53d8\\u91cf\\uff0c\\u8ba1\\u7b97\\u5b9e\\u9645\\u9700\\u6c42\\u4e0e\\u4f9b\\u7ed9\\u7684\\u5e73\\u8861\\u5173\\u7cfb\", \"\\u8bbe\\u7f6e\\u50a8\\u80fd\\u9700\\u6c42\\u7684\\u4e2d\\u6027\\u548c\\u4e50\\u89c2\\u4e24\\u79cd\\u60c5\\u666f\\uff0c\\u6d4b\\u7b97\\u4f9b\\u9700\\u7f3a\\u53e3\\u7684\\u4e0d\\u540c\\u60c5\\u666f\", \"\\u6839\\u636e\\u4f9b\\u9700\\u7f3a\\u53e3\\u53d8\\u5316\\u8d8b\\u52bf\\u5224\\u65ad\\u4ef7\\u683c\\u8d70\\u52bf\\u548c\\u884c\\u4e1a\\u5468\\u671f\\u4f4d\\u7f6e\"]","confidence":0.8,"content":"框架名称：锂资源供需四象限分析框架\n描述：从供给端（海外盐湖、澳矿、海外锂矿、国内锂矿、国内盐湖、回收）和需求端（动力电池、储能电池、小型电池、传统行业）两个维度进行供需平衡预测，引入库存变量调整，计算供需缺口判断市场走势\n核心维度：供给预测, 需求预测, 供需缺口, 价格周期\n步骤：构建供给端分解模型，按地区和技术路线统计各主要矿山/盐湖的产能和产量预测, 构建需求端分解模型，按应用领域统计锂离子电池和传统行业的碳酸锂需求预测, 引入产业链2-4周备货库存变量，计算实际需求与供给的平衡关系, 设置储能需求的中性和乐观两种情景，测算供需缺口的不同情景, 根据供需缺口变化趋势判断价格走势和行业周期位置","is_core":true,"node_type":"framework"},{"id":"fw_fw_236cfdd481094103","name":"全球锂资源供给六分法","type":"methodology","category":"行业分析","industry":"有色金属","steps":"[\"\\u6d77\\u5916\\u76d0\\u6e56\\u677f\\u5757\\u5206\\u6790\\uff1a\\u963f\\u6839\\u5ef7\\u65b0\\u5efa\\u9879\\u76ee\\u722c\\u5761\\u8fdb\\u5ea6\\u3001\\u667a\\u5229SQM\\u548c\\u96c5\\u4fdd\\u6269\\u4ea7\\u8ba1\\u5212\\u3001\\u5df4\\u897f\\u9879\\u76ee\", \"\\u6fb3\\u77ff\\u677f\\u5757\\u5206\\u6790\\uff1aGreenbushes\\u3001Pilgangoora\\u7b49\\u4e3b\\u8981\\u77ff\\u5c71\\u589e\\u91cf\\u9884\\u6d4b\\u3001\\u505c\\u4ea7\\u77ff\\u5c71\\u5f71\\u54cd\", \"\\u975e\\u6d32\\u9502\\u77ff\\u677f\\u5757\\u5206\\u6790\\uff1a\\u4e2d\\u8d44\\u4f01\\u4e1a\\u5728\\u975e\\u9879\\u76ee\\u6295\\u4ea7\\u8fdb\\u5ea6\\u3001\\u6d25\\u5df4\\u5e03\\u97e6\\u548c\\u5c3c\\u65e5\\u5229\\u4e9a\\u8fdb\\u53e3\\u6570\\u636e\", \"\\u56fd\\u5185\\u9502\\u77ff