a81\\u7834\\u8def\\u5f84\\uff1a\\u786b\\u5316\\u7269\\u7535\\u89e3\\u8d28+\\u5e72\\u6cd5\\u6210\\u819c+\\u7b49\\u9759\\u538b\\u5de5\\u827a\"]","confidence":0.8,"content":"框架名称：固态电池技术路线对比分析框架\n描述：通过对比不同电解质材料体系（硫化物、氧化物、聚合物）的性能指标，结合正极（高镍三元、磷酸铁锂）与负极（硅基、锂金属）技术路线的适配性，构建固态电池技术路线选择矩阵，评估各路线的能量密度、安全性、制造难度与成本潜力。\n适用场景：固态电池技术路线选择与商业化路径规划\n核心维度：电解质材料体系、正极技术路线、负极技术路线、制造工艺突破\n步骤：明确固态电池核心性能目标：能量密度>500Wh/kg，本质安全，寿命提升, 对比电解质技术路线：硫化物（最优性能但制造难）、氧化物（稳定性好但导电性一般）、聚合物（易加工但性能受限）, 分析正极适配性：高镍三元与磷酸铁锂并行，不同能量密度需求对应不同正极选择, 分析负极发展方向：硅基为主要方向，锂金属潜力大但挑战多, 综合评估产业化难点：界面阻抗、锂枝晶、制造工艺三大瓶颈, 确定最优突破路径：硫化物电解质+干法成膜+等静压工艺","is_core":true,"node_type":"framework"},{"id":"fw_fw_4f56cd01c1e3","name":"固态电池产业化进程与产业链协同框架","type":"logic","category":"行业分析","industry":"新能源电池行业","steps":"[\"\\u786e\\u5b9a\\u4ea7\\u4e1a\\u5316\\u5173\\u952e\\u65f6\\u95f4\\u8282\\u70b9\\uff1a2026\\u5e74\\u4e3a\\u4ea7\\u4e1a\\u5316\\u5173\\u952e\\u8282\\u70b9\\uff0c2027\\u5e74\\u540e\\u8ba1\\u5212\\u91cf\\u4ea7\", \"\\u5206\\u6790\\u4e0a\\u6e38\\u539f\\u6599\\u7aef\\u673a\\u4f1a\\uff1a\\u9502\\u77ff\\u8d44\\u6e90\\uff08\\u5929\\u9f50\\u9502\\u4e1a\\uff09\\u3001\\u4e13\\u7528\\u8bbe\\u5907\\uff08\\u7eb3\\u79d1\\u8bfa\\u5c14\\u3001\\u534e\\u81ea\\u79d1\\u6280\\uff09\", \"\\u5206\\u6790\\u4e2d\\u6e38\\u6750\\u6599\\u7aef\\u673a\\u4f1a\\uff1a\\u6b63\\u6781\\u6750\\u6599\\uff08\\u53a6\\u94a8\\u65b0\\u80fd\\u3001\\u5f53\\u5347\\u79d1\\u6280\\u3001\\u5bb9\\u767e\\u79d1\\u6280\\uff09\\u3001\\u8d1f\\u6781\\u6750\\u6599\\uff08\\u8d1d\\u7279\\u745e\\uff09\\u3001\\u9694\\u819c\\uff08\\u6069\\u6377\\u80a1\\u4efd\\uff09\\u3001\\u7efc\\u5408\\u6750\\u6599\\uff08\\u749e\\u6cf0\\u6765\\uff09\", \"\\u5206\\u6790\\u4e0b\\u6e38\\u5e94\\u7528\\u7aef\\u673a\\u4f1a\\uff1a\\u7535\\u6c60\\u5236\\u9020\\uff08\\u5b81\\u5fb7\\u65f6\\u4ee3\\u3001\\u4ebf\\u7eac\\u9502\\u80fd\\uff09\", \"\\u8bc4\\u4f30\\u653f\\u7b56\\u652f\\u6301\\u4e0e\\u4ea7\\u4e1a\\u94fe\\u5171\\u632f\\u6548\\u5e94\", \"\\u7efc\\u5408\\u7ed9\\u51fa\\u6295\\u8d44\\u6807\\u7684\\u63a8\\u8350\\u4e0e\\u98ce\\u9669\\u63d0\\u793a\"]","confidence":0.8,"content":"框架名称：固态电池产业化进程与产业链协同框架\n描述：基于产业化时间节点（2026年关键节点、2027年后量产）构建产业链投资分析框架，从上游原料、中游材料、下游应用三个维度识别投资机会，结合政策支持力度与头部企业布局节奏进行产业链价值分配分析。\n适用场景：固态电池产业化节奏与产业链投资机会分析\n核心维度：产业化时间节点、产业链环节、头部企业布局、政策支持\n步骤：确定产业化关键时间节点：2026年为产业化关键节点，2027年后计划量产, 分析上游原料端机会：锂矿资源（天齐锂业）、专用设备（纳科诺尔、华自科技）, 分析中游材料端机会：正极材料（厦钨新能、当升科技、容百科技）、负极材料（贝特瑞）、隔膜（恩捷股份）、综合材料（璞泰来）, 分析下游应用端机会：电池制造（宁德时代、亿纬锂能）, 评估政策支持与产业链共振效应, 综合给出投资标的推荐与风险提示","is_core":true,"node_type":"framework"}],"_relatedEntities":[{"id":"ent_2ed27bde01cf","name":"周晓航","type":"PERSON","relations":["合作"],"relation_count":1,"description":"周晓航作为自然资源保护协会的代表，与车百智库研究院联合开展动力电池回收研究，在推动绿色循环体系建设方面提供专业支持和政策建议","dir":"in","descriptions":["周晓航作为自然资源保护协会的代表，与车百智库研究院联合开展动力电池回收研究，在推动绿色循环体系建设方面提供专业支持和政策建议"]},{"id":"ent_fcddaa643592","name":"车百智库研究院","type":"ORG","relations":["合作"],"relation_count":1,"description":"自然资源保护协会与车百智库研究院联合开展动力电池回收研究，共同发布《动力电池回收：构建绿色循环体系》报告","dir":"out","descriptions":["自然资源保护协会与车百智库研究院联合开展动力电池回收研究，共同发布《动力电池回收：构建绿色循环体系》报告"]},{"id":"ent_d71686ff1511","name":"中国","type":"PLACE","relations":["合作"],"relation_count":1,"description":"自然资源保护协会（NRDC）在中国北京设有办公室，参与中国动力电池碳足迹及低碳循环发展白皮书等项目合作","dir":"out","descriptions":["自然资源保护协会（NRDC）在中国北京设有办公室，参与中国动力电池碳足迹及低碳循环发展白皮书等项目合作"]},{"id":"ent_02a5a4b15bc4","name":"动力电池回收行业","type":"INDUSTRY","relations":["合作"],"relation_count":1,"description":"自然资源保护协会作为国际环保组织，关注并推动中国动力电池回收行业的绿色循环发展和可持续性","dir":"out","descriptions":["自然资源保护协会作为国际环保组织，关注并推动中国动力电池回收行业的绿色循环发展和可持续性"]}],"_reports":[{"report_id":"rpt_39cdcf8e8e8c","title":"2026动力电池回收构建绿色循环体系报告_22页_1mb","source":"券商研报","publish_date":"2025-12-01","industry":"新能源电池行业"}]},{"id":"ent_45588815200a","name":"节能环境","type":"ORG","industry":"环保","desc":"拟每10股派发现金红利0.6元，不进行资本公积金转增股本或送红股。","is_core":true,"node_type":"entity","typeLabel":"ORG","sector":"环保","subIndustry":"","color":"","core":true,"importance":0,"publishDate":"","val":4,"description":"拟每10股派发现金红利0.6元，不进行资本公积金转增股本或送红股。","_logicRefs":[{"id":"log_9002f3d75b2ce4d3","logic_