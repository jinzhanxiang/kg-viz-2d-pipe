能中长期规划对可再生能源制氢的规划，预计氢能渗透率从202,推导出2025年为氢能中长期规划第一个结算点，前期基础设施、设备技","dimension":"2","confidence":0.9,"is_core":true,"scope":"industry","node_type":"logic"},{"id":"log_e4ba1f45431d5eea","logic_id":"e4ba1f45431d5eea","type":"趋势","premise":"可再生能源发电呈现上半年多于下半年的趋势；需要采用跨季度储能手段进行调控；氢能是适合长周期储能的重要方式","conclusion":"2021年跨季度储能氢气用量0.02万吨，2025年约1万吨，2030年达162万吨，年复合增长率70%","text":"从可再生能源发电呈现上半年多于下半年的趋势；需要采用跨季度储能的趋势分析,判断2021年跨季度储能氢气用量0.02万吨，2025年约1万吨","dimension":"2","confidence":0.9,"is_core":true,"scope":"industry","node_type":"logic"}],"_indicators":[{"id":"ind_ind_7bb7997483f0","indicator_id":"ind_7bb7997483f0","name":"1吨煤发电量","type":"营运","unit":"kWh","value":"3333","is_core":true,"node_type":"indicator"},{"id":"ind_ind_09f99b97ef6f","indicator_id":"ind_09f99b97ef6f","name":"1吨煤对应二氧化碳排放量","type":"成本","unit":"吨","value":"2.62","is_core":true,"node_type":"indicator"},{"id":"ind_ind_dd0175769358","indicator_id":"ind_dd0175769358","name":"2021年中国碳排放量","type":"规模","unit":"亿吨","value":"199","is_core":true,"node_type":"indicator"},{"id":"ind_ind_83c56db6788f","indicator_id":"ind_83c56db6788f","name":"2021年电力行业碳排放占比","type":"份额","unit":"%","value":"42","is_core":true,"node_type":"indicator"},{"id":"ind_ind_3bef469666f7","indicator_id":"ind_3bef469666f7","name":"2030年储能领域氢气需求","type":"规模","unit":"万吨","value":"230","is_core":true,"node_type":"indicator"},{"id":"ind_ind_e3fc0f7425e6","indicator_id":"ind_e3fc0f7425e6","name":"2030年储能领域电解槽累计装机","type":"规模","unit":"GW","value":"57","is_core":true,"node_type":"indicator"},{"id":"ind_ind_a424edc04332","indicator_id":"ind_a424edc04332","name":"2030年储能领域电解槽累计装机量","type":"规模","unit":"GW","value":"57","is_core":true,"node_type":"indicator"},{"id":"ind_ind_42cc85002837","indicator_id":"ind_42cc85002837","name":"2030年储能领域绿氢产量","type":"规模","unit":"万吨","value":"230","is_core":true,"node_type":"indicator"}],"_frameworks":[{"id":"fw_fw_4cfb25ab83a5","name":"储能行业五大变化跟踪框架","type":"core_architecture","category":"行业分析","industry":"电力设备/储能","steps":"[\"\\u53d8\\u5316\\u4e00\\uff1a\\u7535\\u529b\\u73b0\\u8d27\\u5cf0\\u8c37\\u4ef7\\u5dee\\u662f\\u6bd4\\u62db\\u6807\\u6570\\u636e\\u66f4\\u524d\\u77bb\\u7684\\u666f\\u6c14\\u5ea6\\u6307\\u6807\\uff0c\\u9700\\u8ddf\\u8e2a\\u5404\\u7701\\u4ef7\\u5dee\\u6570\\u636e\", \"\\u53d8\\u5316\\u4e8c\\uff1a\\u5bb9\\u91cf\\u8865\\u507f\\u673a\\u5236\\u843d\\u5730\\u8fdb\\u5ea6\\u5f71\\u54cd\\u50a8\\u80fd\\u7b2c\\u4e8c\\u5927\\u6536\\u5165\\u6765\\u6e90\\uff0c\\u9700\\u5173\\u6ce8\\u5404\\u7701\\u653f\\u7b56\\u63a8\\u8fdb\", \"\\u53d8\\u5316\\u4e09\\uff1aAIDC\\u914d\\u50a8\\u9879\\u76ee\\u843d\\u5730\\u8fdb\\u5c55\\u662f\\u7f8e\\u56fd\\u5e02\\u573a\\u8d85\\u9884\\u671f\\u7684\\u5173\\u952e\\u53d8\\u91cf\", \"\\u53d8\\u5316\\u56db\\uff1a\\u6b27\\u6d32MACSE\\u3001\\u4fdd\\u5e95\\u6536\\u76ca\\u7b49\\u673a\\u5236\\u521b\\u65b0\\u63a8\\u52a8\\u6b27\\u6d32\\u6210\\u4e3a\\u6d77\\u5916\\u7b2c\\u4e00\\u5927\\u589e\\u91cf\\u5e02\\u573a\", \"\\u53d8\\u5316\\u4e94\\uff1a\\u78b3\\u9178\\u9502\\u4ef7\\u683c\\u4e0e\\u50a8\\u80fd\\u7ecf\\u6d4e\\u6027\\u4e92\\u4e3a\\u56e0\\u679c\\uff0c\\u9700\\u5173\\u6ce8\\u5e73\\u8861\\u70b9\"]","confidence":0.8,"content":"框架名称：储能行业五大变化跟踪框架\n描述：通过跟踪电力现货市场峰谷价差、容量补偿机制推进、AIDC配储项目落地、欧洲大储机制创新、上游原材料价格五大维度，构建储能行业景气度跟踪体系。\n适用场景：储能行业投资决策、行业景气度判断\n核心维度：电力现货市场|容量补偿|AIDC|欧洲大储|碳酸锂价格\n步骤：变化一：电力现货峰谷价差是比招标数据更前瞻的景气度指标，需跟踪各省价差数据, 变化二：容量补偿机制落地进度影响储能第二大收入来源，需关注各省政策推进, 变化三：AIDC配储项目落地进展是美国市场超预期的关键变量, 变化四：欧洲MACSE、保底收益等机制创新推动欧洲成为海外第一大增量市场, 变化五：碳酸锂价格与储能经济性互为因果，需关注平衡点","is_core":true,"node_type":"framework"},{"id":"fw_fw_61a61ebaec56","name":"储能长期空间测算框架","type":"logic","category":"行业分析","industry":"电力设备/储能","steps":"[\"\\u7b2c\\u4e00\\u6b65\\uff1a\\u786e\\u5b9a\\u5df4\\u9ece\\u534f\\u5b9aNDCs\\u76ee\\u6807\\u7ea6\\u675f\\uff0c\\u4e2d\\u7f8e\\u6b272035\\u5e74\\u78b3\\u6392\\u653e\\u76ee\\u6807\\u660e\\u786e\", \"\\u7b2c\\u4e8c\\u6b65\\uff1a\\u63a8\\u5bfc\\u98ce\\u5149\\u50a8\\u5e74\\u65b0\\u589e\\u88c5\\u673a\\u5cf0\\u503c\\u51fa\\u73b0\\u57282035\\u5e74\\u5de6\\u53f3\", \"\\u7b2c\\u4e09\\u6b65\\uff1a\\u6d4b\\u7b97\\u50a8\\u80fd\\u88c5\\u673a\\u5929\\u82b1\\u677f\\u500d\\u6570\\u548c\\u51fa\\u8d27\\u91cf\\u5cf0\\u503c\", \"\\u7b2c\\u56db\\u6b65\\uff1a\\u8ba1\\u7b972024-2035\\u5e74CAGR\\u9a8c\\u8bc1\\u589e\\u957f\\u786e\\u5b9a\\u6027\"]","confidence":0.8,"content":"框架名称：储能长期空间测算框架\n描述：基于巴黎协定NDCs框架和双碳目标，从终局思维出发，通过能源转型→双碳目标→风光需求→储能需求的逻辑链条测算长期空间。\n适用场景：储能市场规模预测、长期空间判断\n核心维度：NDCs目标|风光装机|储能需求|CAGR\n步骤：第一步：确定巴黎协定NDCs目标约束，中美欧2035年碳排放目标明确, 第二步：推导风光储年新增装机峰值出现在2035年左右, 第三步：测算储能装机天花板倍数和出货量峰值, 第四步：计算2024-2035年CAGR验证增长确定性","is_core":true,"node_type":"framework"}],"_relatedEntities":[{"id":"ent_cf6d68b5eca5","name":"双碳政策","type":"POLICY","relations":["监管"],"relation_count":1,"description":"双碳政策推动下全国碳排放权交易市场于2021年7月正式启动，成为全球覆盖碳排放规模最大的碳市场，电力行业成为碳交易市场先行试验田","dir":"in","descriptions":["双碳政策推动下全国碳排放权交易市场于2021年7月正式启动，成为全球覆盖碳排放规模最大的碳市场，电力行业成为碳交易市场先行试验田"]}],"_reports":[{"report_id":"rpt_6889468ac6c7","title":"深度报告-国金证券-氢能_燃料电池行业研究_氢能_燃料电池行业产业链系列报告之十五-碳中和及储能背景下_千亿氢储能市场一触即发_33页_3mb","source":"券商研报","publish_date":"2023-04-29","industry":"电力设备/储能"}]},{"id":"ent_03dab28074fe","name":"碳普惠平台","type":"INDUSTRY","industry":"环保","desc":"连接业主碳积分与碳资产管理的数字化平台，业主通过参与垃圾分类、绿色出行、节能用电等低碳行为获得碳积分，可在平台兑换商品或服务，同时可将碳积分转化为碳资产参与交易。预期2040年业主碳积分兑换率≥60%，实现居民端碳减排激励机制。","is_core":false,"node_type":"entity","typeLabel":"INDUSTRY","sector":"环保","subIndustry":"","color":"","core":false,"importance":0,"publishDate":"","val":4,"description":"连接业主碳积分与碳资产管理的数字化平台，业主通过参与垃圾分类、绿色出行、节能用电等低碳行为获得碳积分，可在平台兑换商品或服务，同时可将碳积分转化为碳资产参与交易。预期2040年业主碳积分兑换率≥60%，实现居民端碳减排激励机制。","_logicRefs":[{"id":"log_52fbeb2c2fe7f3f6","logic_id":"52fbeb2c2fe7f3f6","type":"因果","premise":"行业趋势显示物业行业碳排放结构中范围二占比高达60%-70%，公区设施（照明/电梯/水泵）排放占范围二主体部分，长期存在责任归属模糊问题","conclusion":"物业行业碳核算与管理的首要突破点是范围二公区排放的权责界定与核算方法标准化","text":"基于行业趋势显示物业行业碳排放结构中范围二占比高达60%-70%,推导出物业行业碳核算与管理的首要突破点是范围二公区排放的权责界定与","dimension":"2","confidence":0.95,"is_core":true,"scope":"industry","node_type":"logic"},{"id":"log_66a6d734e0c2f070","logic_id":"66a6d734e0c2f070","type":"趋势","premise":"行业趋势显示物业碳中和转型需经历三个阶段，核心驱动力从数据驱动演进为技术驱动再到生态驱动，管理范围从企业碳扩展至城市碳","conclusion":"物业碳中和转型路径需分阶段推进，每个阶段有明确的核心理念和关键任务","text":"从行业趋势显示物业碳中和转型需经历三个阶段，核心驱动力从数据驱的趋势分析,判断物业碳中和转型路径需分阶段推进，每个阶段有明确的核心理念和关","dimension":"2","confidence":0.92,"is_core":true,"scope":"industry","node_type":"logic"},{"id":"log_f2a05d7495fb37d2","logic_id":"f2a05d7495fb37d2","type":"对比","premise":"行业产业格局显示物业行业范围一（15%-20%）、范围二（60%-70%）、范围三（10%-25%）的排放结构差异显著，各范围排放源的可控性和减排难度不同","conclusion":"物业碳减排应分范围制定差异化策略，范围二（占比最高）应作为首要攻坚重点","text":"通过对比行业产业格局显示物业行业范围一（15%-20%）、范围二（6,得出物业碳减排应分范围制定差异化策略，范围二（占比最高）应作为首","dimension":"2","confidence":0.9,"is_core":false,"scope":"industry","node_type":"logic"},{"id":"log_f943e344a44764a6","logic_id":"f943e344a44764a6","type":"趋势","premise":"行业趋势显示范围三包含15类排放，物业企业数据基础和能力有限，应根据重要性原则和数据可行性选择性纳入","conclusion":"范围三管理应采取务实聚焦策略，从高占比、高可行性的3类排放起步","text":"从行业趋势显示范围三包含15类排放，物业企业数据基础和能力有限的趋势分析,判断范围三管理应采取务实聚焦策略，从高占比、高可行性的3类排放起","dimension":"2","confidence":0.87,"is_core":false,"scope":"industry","node_type":"logic"},{"id":"log_cd2f436aacd0beec","logic_id":"cd2f436aacd0beec","type":"因果","premise":"物业行业碳减排需要经济激励驱动，碳资产开发与绿色金融创新为物业公司提供了除物业费外的第四收入来源","conclusion":"碳市场交易、绿色金融、碳普惠机制为物业企业构建了多元化的碳资产收益化路径，形成经济激励闭环。光伏CCER项目年开发碳汇≥50万吨CO₂e，收益≥营业收入5%，ABS融资覆盖改造成本50%，激励物业公司","text":"数据引用：节能收益权ABS融资覆盖改造成本50%，光伏CCER项目年开发碳汇≥50万吨CO₂e，碳资产开发收益目标≥营业收入5%，碳普惠平台业主碳积分兑换率≥60%，绿色供应链金融对低碳供应商提供账期优惠。这些收益渠道形成了从减排投资到收益回报的完整闭环，使物业公司从“成本承担者”转变为“价值创造者”，激发主动减排的内生动力。","dimension":"6","confidence":0.85,"is_core":true,"scope":"industry","node_type":"logic"}],"_indicators":[],"_frameworks":[{"id":"fw_fw_9a95768cb511","name":"物业碳排放三范围全景核算框架","type":"core_architecture","category":"行业分析","industry":"物业管理","steps":"[\"\\u754c\\u5b9a\\u7ec4\\u7ec7\\u8fb9\\u754c\\uff1a\\u91c7\\u7528\\u8fd0\\u8425\\u63a7\\u5236\\u6743\\u6cd5\\uff0c\\u660e\\u786e\\u7269\\u4e1a\\u516c\\u53f8\\u62e5\\u6709\\u6216\\u63a7\\u5236\\u7684\\u6392\\u653e\\u6e90\\u8303\\u56f4\", \"\\u5212\\u5206\\u8fd0\\u8425\\u8fb9\\u754c\\uff1a\\u6309GHG Protocol\\u4e09\\u8303\\u56f4\\u5206\\u7c7b\\uff0c\\u8303\\u56f4\\u4e00/\\u4e8c\\u5168\\u9762\\u8986\\u76d6\\uff0c\\u8303\\u56f4\\u4e09\\u805a\\u7126\\u9ad8\\u91cd\\u8981\\u6027\\u9879\\uff08S3-A\\u91c7\\u8d2d\\u3001S3-B\\u80fd\\u6e90\\u4e0a\\u6e38\\u3001S3-C\\u5546\\u52a1\\u65c5\\u884c\\uff09\", \"\\u8bc6\\u522b\\u6392\\u653e\\u6e90\\uff1a\\u5efa\\u7acb\\u6392\\u653e\\u6e90\\u7f16\\u7801\\u4f53\\u7cfb\\uff08S1-A-01\\u5929\\u7136\\u6c14\\u71c3\\u70e7\\u81f3S3-C-02\\u5546\\u52a1\\u65c5\\u884c\\u4f4f\\u5bbf\\uff09\\uff0c\\u660e\\u786e\\u6d3b\\u52a8\\u6570\\u636e\\u3001\\u6392\\u653e\\u56e0\\u5b50\\u3001\\u6570\\u636e\\u6765\\u6e90\", \"\\u5efa\\u7acb\\u8d23\\u4efb\\u77e9\\u9635\\uff1a\\u533a\\u5206\\u7269\\u4e1a\\u5168\\u8d23\\u4e0e\\u95f4\\u63a5\\u8d23\\u4efb\\uff0c\\u8303\\u56f4\\u4e00/\\u4e8c\\u7531\\u7269\\u4e1a\\u627f\\u62c5\\uff0c\\u8303\\u56f4\\u4e09\\u901a\\u8fc7\\u5408\\u540c/\\u4f9b\\u5e94\\u5546\\u8c03\\u67e5\\u83b7\\u53d6\\u6570\\u636e\", \"\\u6301\\u7eed\\u8fed\\u4ee3\\uff1a\\u9075\\u5faa\\u91cd\\u8981\\u6027\\u539f\\u5219\\u548c\\u6570\\u636e\\u53ef\\u884c\\u6027\\uff0c\\u4ece\\u805a\\u7126\\u9879\\u9010\\u6b65\\u6269\\u5c55\\u81f3\\u5168\\u90e815\\u7c7b\\u8303\\u56f4\\u4e09\\u6392\\u653e\"]","confidence":0.8,"content":"框架名称：物业碳排放三范围全景核算框架\n描述：基于GHG Protocol标准框架，建立物业行业专属的三范围碳排放核算体系。范围一聚焦直接排放（天然气/汽油/柴油燃烧），范围二聚焦外购能源间接排放（电力/热力消耗，尤其公区照明/电梯/水泵），范围三聚焦价值链排放（采购商品/服务、能源上游、商务旅行）。通过运营控制权法界定组织边界，物理边界限定项目红线内设施，责任归属明确物业全责或间接责任。\n适用场景：物业企业碳排放核算体系建设与行业标准制定参考\n核心维度：物理边界、运营边界、责任归属、数据来源\n步骤：界定组织边界：采用运营控制权法，明确物业公司拥有或控制的排放源范围, 划分运营边界：按GHG Protocol三范围分类，范围一/二全面覆盖，范围三聚焦高重要性项（S3-A采购、S3-B能源上游、S3-C商务旅行）, 识别排放源：建立排放源编码体系（S1-A-01天然气燃烧至S3-C-02商务旅行住宿），明确活动数据、排放因子、数据来源, 建立责任矩阵：区分物业全责与间接责任，范围一/二由物业承担，范围三通过合同/供应商调查获取数据, 持续迭代：遵循重要性原则和数据可行性，从聚焦项逐步扩展","is_core":true,"node_type":"framework"},{"id":"fw_fw_27ee074affac","name":"物业岗位碳排放责任矩阵","type":"methodology","category":"公司分析","industry":"物业管理","steps":"[\"\\u8bc6\\u522b\\u5173\\u952e\\u6392\\u653e\\u573a\\u666f\\uff1a\\u6309\\u5c97\\u4f4d\\u68b3\\u7406\\u4e3b\\u8981\\u78b3\\u6392\\u653e\\u6e90\\uff08\\u8bbe\\u5907\\u8fd0\\u884c\\u3001\\u71c3\\u6cb9\\u6d88\\u8017\\u3001\\u529e\\u516c\\u7528\\u7535\\u3001\\u5dee\\u65c5\\u4ea4\\u901a\\uff09\", \"\\u5236\\u5b9a\\u63a7\\u78b3\\u63aa\\u65bd\\uff1a\\u9488\\u5bf9\\u5404\\u5c97\\u4f4d\\u6392\\u653e\\u7279\\u70b9\\u63d0\\u51fa\\u5177\\u4f53\\u51cf\\u6392\\u884c\\u52a8\\uff08\\u667a\\u80fd\\u7535\\u8868\\u5206\\u9879\\u8ba1\\u91cf\\u3001\\u7535\\u52a8\\u8bbe\\u5907\\u66ff\\u6362\\u3001\\u65e0\\u7eb8\\u5316\\u6d41\\u7a0b\\u3001\\u4f1a\\u8bae\\u78b3\\u8db3\\u8ff9\\u6838\\u7b97\\uff09\", \"\\u5efa\\u7acb\\u4e3b\\u4f4e\\u78b3\\u884c\\u4e3a\\u89c4\\u8303\\uff1a\\u5c06\\u51cf\\u6392\\u63aa\\u65bd\\u8f6c\\u5316\\u4e3a\\u65e5\\u5e38\\u884c\\u4e3a\\u51c6\\u5219\\uff0c\\u5f62\\u6210\\u53ef\\u6267\\u884c\\u7684\\u5c97\\u4f4d\\u78b3\\u7ba1\\u7406\\u6307\\u5f15\", \"\\u914d\\u5957\\u80fd\\u529b\\u5efa\\u8bbe\\uff1a\\u660e\\u786e\\u5c97\\u4f4d\\u6838\\u5fc3\\u6280\\u80fd\\u8981\\u6c42\\u548c\\u57f9\\u8bad\\u8ba4\\u8bc1\\u6807\\u51c6\\uff0c\\u786e\\u4fdd\\u78b3\\u7ba1\\u7406\\u80fd\\u529b\\u5230\\u4f4d\"]","confidence":0.8,"content":"框架名称：物业岗位碳排放责任矩阵\n描述：将碳排放指标分解至物业各岗位一线员工，建立岗位碳排放及控制地图。工程维护岗负责设备房运行（水泵/空调/电梯能耗）、制冷剂加注；环境管理岗负责绿化机械燃油消耗、垃圾清运车辆；秩序巡逻岗负责巡逻车充电、岗亭取暖制冷；客户服务岗负责纸质工单打印、办公设备待机；管理层负责差旅交通、数据中心运行。配套岗位技能要求（能效诊断、数据采集、SPC方法）和培训认证标准（ISO14064-3、CEM、六西格玛绿带）。\n适用场景：物业公司碳管理能力建设与岗位责任落实\n核心维度：岗位角色、排放场景、控碳措施、低碳行为\n步骤：识别关键排放场景：按岗位梳理主要碳排放源（设备运行、燃油消耗、办公用电、差旅交通）, 制定控碳措施：针对各岗位排放特点提出具体减排行动（智能电表分项计量、电动设备替换、无纸化流程、会议碳足迹核算）, 建立主低碳行为规范：将减排措施转化为日常行为准则，形成可执行的岗位碳管理指引, 配套能力建设：明确岗位核心技能要求和培训认证标准，确保碳管理能力到位","is_core":true,"node_type":"framework"}],"_relatedEntities":[{"id":"ent_d46a64673e28","name":"物业行业","type":"INDUSTRY","relations":["上下游"],"relation_count":1,"description":"碳普惠平台为物业行业的业主低碳行为提供激励和变现渠道，通过业主碳积分兑换机制链接640万家庭，物业微电网接入城市虚拟电厂承接市政绿化管养，碳普惠平台使业主的节能行为转化为可量化的经济收益","dir":"out","descriptions":["碳普惠平台为物业行业的业主低碳行为提供激励和变现渠道，通过业主碳积分兑换机制链接640万家庭，物业微电网接入城市虚拟电厂承接市政绿化管养，碳普惠平台使业主的节能行为转化为可量化的经济收益"]},{"id":"ent_9f7db1d8201c","name":"中海物业","t