ustry","node_type":"logic"},{"id":"log_62c414881f35cb73","logic_id":"62c414881f35cb73","type":"对比","premise":"垃圾焚烧自由现金流转正前后，分红比例从21年低点18%，22-24年连续提至40%，典型公司永兴（24年分红比例66%）军信（95%）绿动（71%）。水务运营24年分红比例为34%，剔除已经分红50%","conclusion":"水务运营行业有望复制垃圾焚烧行业现金流改善、分红提升路径","text":"垃圾焚烧行业自由现金流转正后，分红比例从18%提升至40%，提升22pct，典型公司分红比例达66%-95%；水务运营行业24年分红比例34%，核心公司兴蓉分红28%，预计资本开支25年下降，26年开始大幅下降，自由现金流大增可期，分红提升空间较大","dimension":"2","confidence":0.75,"is_core":true,"scope":"industry","node_type":"logic"}],"_indicators":[{"id":"ind_ind_2b13ae2e1ca9","indicator_id":"ind_2b13ae2e1ca9","name":"2025H1分红比例","type":"其他","unit":"%","value":"40","is_core":true,"node_type":"indicator"},{"id":"ind_ind_4248765f5251","indicator_id":"ind_4248765f5251","name":"2025H1归母净利润","type":"财务","unit":"亿元","value":"51","is_core":true,"node_type":"indicator"},{"id":"ind_ind_d8f625f3ad95","indicator_id":"ind_d8f625f3ad95","name":"2025H1期间费用率","type":"利润率","unit":"%","value":"12.7","is_core":true,"node_type":"indicator"},{"id":"ind_ind_4398762872ba","indicator_id":"ind_4398762872ba","name":"2025H1经营性现金流净额","type":"营运","unit":"亿元","value":"69","is_core":true,"node_type":"indicator"},{"id":"ind_ind_4a588cc3b0bd","indicator_id":"ind_4a588cc3b0bd","name":"2025H1自由现金流","type":"营运","unit":"亿元","value":"32","is_core":true,"node_type":"indicator"},{"id":"ind_ind_70d2a5f22379","indicator_id":"ind_70d2a5f22379","name":"2025H1营收","type":"规模","unit":"亿元","value":"232","is_core":true,"node_type":"indicator"},{"id":"ind_ind_053f8d1ecb5d","indicator_id":"ind_053f8d1ecb5d","name":"2025H1财务费用率","type":"利润率","unit":"%","value":"5.3","is_core":true,"node_type":"indicator"},{"id":"ind_ind_b216afc93464","indicator_id":"ind_b216afc93464","name":"2025H1资本开支","type":"成本","unit":"亿元","value":"38","is_core":true,"node_type":"indicator"}],"_frameworks":[{"id":"fw_fw_75432105562449ae","name":"锂资源供需四象限分析框架","type":"core_architecture","category":"行业分析","industry":"有色金属","steps":"[\"\\u6784\\u5efa\\u4f9b\\u7ed9\\u7aef\\u5206\\u89e3\\u6a21\\u578b\\uff0c\\u6309\\u5730\\u533a\\u548c\\u6280\\u672f\\u8def\\u7ebf\\u7edf\\u8ba1\\u5404\\u4e3b\\u8981\\u77ff\\u5c71/\\u76d0\\u6e56\\u7684\\u4ea7\\u80fd\\u548c\\u4ea7\\u91cf\\u9884\\u6d4b\", \"\\u6784\\u5efa\\u9700\\u6c42\\u7aef\\u5206\\u89e3\\u6a21\\u578b\\uff0c\\u6309\\u5e94\\u7528\\u9886\\u57df\\u7edf\\u8ba1\\u9502\\u79bb\\u5b50\\u7535\\u6c60\\u548c\\u4f20\\u7edf\\u884c\\u4e1a\\u7684\\u78b3\\u9178\\u9502\\u9700\\u6c42\\u9884\\u6d4b\", \"\\u5f15\\u5165\\u4ea7\\u4e1a\\u94fe2-4\\u5468\\u5907\\u8d27\\u5e93\\u5b58\\u53d8\\u91cf\\uff0c\\u8ba1\\u7b97\\u5b9e\\u9645\\u9700\\u6c42\\u4e0e\\u4f9b\\u7ed9\\u7684\\u5e73\\u8861\\u5173\\u7cfb\", \"\\u8bbe\\u7f6e\\u50a8\\u80fd\\u9700\\u6c42\\u7684\\u4e2d\\u6027\\u548c\\u4e50\\u89c2\\u4e24\\u79cd\\u60c5\\u666f\\uff0c\\u6d4b\\u7b97\\u4f9b\\u9700\\u7f3a\\u53e3\\u7684\\u4e0d\\u540c\\u60c5\\u666f\", \"\\u6839\\u636e\\u4f9b\\u9700\\u7f3a\\u53e3\\u53d8\\u5316\\u8d8b\\u52bf\\u5224\\u65ad\\u4ef7\\u683c\\u8d70\\u52bf\\u548c\\u884c\\u4e1a\\u5468\\u671f\\u4f4d\\u7f6e\"]","confidence":0.8,"content":"框架名称：锂资源供需四象限分析框架\n描述：从供给端（海外盐湖、澳矿、海外锂矿、国内锂矿、国内盐湖、回收）和需求端（动力电池、储能电池、小型电池、传统行业）两个维度进行供需平衡预测，引入库存变量调整，计算供需缺口判断市场走势\n核心维度：供给预测, 需求预测, 供需缺口, 价格周期\n步骤：构建供给端分解模型，按地区和技术路线统计各主要矿山/盐湖的产能和产量预测, 构建需求端分解模型，按应用领域统计锂离子电池和传统行业的碳酸锂需求预测, 引入产业链2-4周备货库存变量，计算实际需求与供给的平衡关系, 设置储能需求的中性和乐观两种情景，测算供需缺口的不同情景, 根据供需缺口变化趋势判断价格走势和行业周期位置","is_core":true,"node_type":"framework"},{"id":"fw_fw_236cfdd481094103","name":"全球锂资源供给六分法","type":"methodology","category":"行业分析","industry":"有色金属","steps":"[\"\\u6d77\\u5916\\u76d0\\u6e56\\u677f\\u5757\\u5206\\u6790\\uff1a\\u963f\\u6839\\u5ef7\\u65b0\\u5efa\\u9879\\u76ee\\u722c\\u5761\\u8fdb\\u5ea6\\u3001\\u667a\\u5229SQM\\u548c\\u96c5\\u4fdd\\u6269\\u4ea7\\u8ba1\\u5212\\u3001\\u5df4\\u897f\\u9879\\u76ee\", \"\\u6fb3\\u77ff\\u677f\\u5757\\u5206\\u6790\\uff1aGreenbushes\\u3001Pilgangoora\\u7b49\\u4e3b\\u8981\\u77ff\\u5c71\\u589e\\u91cf\\u9884\\u6d4b\\u3001\\u505c\\u4ea7\\u77ff\\u5c71\\u5f71\\u54cd\", \"\\u975e\\u6d32\\u9502\\u77ff\\u677f\\u5757\\u5206\\u6790\\uff1a\\u4e2d\\u8d44\\u4f01\\u4e1a\\u5728\\u975e\\u9879\\u76ee\\u6295\\u4ea7\\u8fdb\\u5ea6\\u3001\\u6d25\\u5df4\\u5e03\\u97e6\\u548c\\u5c3c\\u65e5\\u5229\\u4e9a\\u8fdb\\u53e3\\u6570\\u636e\", \"\\u56fd\\u5185\\u9502\\u77ff\\u677f\\u5757\\u5206\\u6790\\uff1a\\u6c5f\\u897f\\u77ff\\u8bc1\\u6270\\u52a8\\u3001\\u56db\\u5ddd\\u7532\\u57fa\\u5361\\u548c\\u674e\\u5bb6\\u6c9f\\u3001\\u65b0\\u7586\\u5927\\u7ea2\\u67f3\\u6ee9\\u6295\\u4ea7\", \"\\u56fd\\u5185\\u76d0\\u6e56\\u677f\\u5757\\u5206\\u6790\\uff1a\\u9752\\u6d77\\u5bdf\\u5c14\\u6c57\\u76d0\\u6e56\\u5404\\u4f01\\u4e1a\\u3001\\u897f\\u85cf\\u5404\\u76d0\\u6e56\\u9879\\u76ee\\u89c4\\u5212\\u548c\\u5728\\u5efa\\u8fdb\\u5ea6\", \"\\u56de\\u6536\\u677f\\u5757\\u5206\\u6790\\uff1a\\u5e9f\\u6599\\u56de\\u6536\\u4ea7\\u80fd\\u589e\\u957f\\u5bf9\\u4f9b\\u7ed9\\u7684\\u8865\\u5145\\u4f5c\\u7528\"]","confidence":0.8,"content":"框架名称：全球锂资源供给六分法\n描述：将全球锂资源供给来源分为六大板块进行详细分析和预测：海外盐湖（阿根廷、智利）、澳矿、非洲锂矿、南美其他、 国内锂矿（江西宜春、四川、新疆）、国内盐湖（青海、西藏），评估各板块的增量释放节奏和贡献度\n核心维度：海外盐湖, 澳矿, 非洲锂矿, 国内锂矿, 国内盐湖, 回收\n步骤：海外盐湖板块分析：阿根廷新建项目爬坡进度、智利SQM和雅保扩产计划、巴西项目, 澳矿板块分析：Greenbushes、Pilgangoora等主要矿山增量预测、停产矿山影响, 非洲锂矿板块分析：中资企业在非项目投产进度、津巴布韦和尼日利亚进口数据, 国内锂矿板块分析：江西矿证扰动、四川甲基卡和李家沟、新疆大红柳滩投产, 国内盐湖板块分析：青海察尔汗盐湖各企业、西藏各盐湖项目规划和在建进度, 回收板块分析：废料回收产能增长对供给的补充作用","is_core":true,"node_type":"framework"}],"_relatedEntities":[{"id":"ent_f01c89b2114e","name":"全国碳市场建设意见","type":"POLICY","relations":["监管"],"relation_count":1,"description":"《意见》明确碳排放配额总量控制和有偿分配比例提升，垃圾发电等绿电资产的零碳属性价值凸显，利好垃圾焚烧行业资产价值重估","dir":"in","descriptions":["《意见》明确碳排放配额总量控制和有偿分配比例提升，垃圾发电等绿电资产的零碳属性价值凸显，利好垃圾焚烧行业资产价值重估"]}],"_reports":[{"report_id":"rpt_952a771c4256","title":"东吴证券-环保行业跟踪周报_固废提质增效_现金流改善逻辑持续兑现_加强全国碳市场建设碳约束趋严_32页_2mb","source":"券商研报","publish_date":"2025-09-02","industry":"有色金属/锂"},{"report_id":"rpt_e7c933490657","title":"20250902-东吴证券-环保行业跟踪周报_固废提质增效_现金流改善逻辑持续兑现_加强全国碳市场建设碳约束趋严_32页_2mb","source":"券商研报","publish_date":"2025-09-02","industry":"有色金属/锂"}]},{"id":"ent_faa2a40a74c5","name":"宇通重工","type":"ORG","industry":"环保","desc":"宇通重工是国内专业的环卫装备制造商，在新能源环卫车领域具有显著的竞争优势。根据东吴证券2025年9月发布的研究报告，公司新能源装备销量占比达68%，为行业最高水平，2025年7月新能源环卫车销量1041辆，同比增长27.11%，市场渗透率达17.94%。从市场竞争格局看，公司在环卫车整体市场位列第七，2024年1-9月销售1386辆，市占率3.15%；在新能源环卫车细分市场表现更为突出，市占率排名第二达15.15%，销售1075辆同比增长29.21%，显示其在新能源转型中具备较强的先发优势和市场地位。","is_core":true,"node_type":"entity","typeLabel":"ORG","sector":"环保","subIndustry":"","color":"","core":true,"importance":0,"publishDate":"","val":4,"description":"宇通重工是国内专业的环卫装备制造商，在新能源环卫车领域具有显著的竞争优势。根据东吴证券2025年9月发布的研究报告，公司新能源装备销量占比达68%，为行业最高水平，2025年7月新能源环卫车销量1041辆，同比增长27.11%，市场渗透率达17.94%。从市场竞争格局看，公司在环卫车整体市场位列第七，2024年1-9月销售1386辆，市占率3.15%；在新能源环卫车细分市场表现更为突出，市占率排名第二达15.15%，销售1075辆同比增长29.21%，显示其在新能源转型中具备较强的先发优势和市场地位。","_logicRefs":[{"id":"log_952bf01e23b9a2a9","logic_id":"952bf01e23b9a2a9","type":"因果","premise":"垃圾焚烧行业资本开支25H1为38亿元（-19%），经营性现金流净额69亿元（+9%），自由现金流持续增厚","conclusion":"垃圾焚烧行业分红潜力提升，24年板块分红比例40%，稳态下分红潜力达97%～120%，预计26年标的分红潜力达50%～150%+","text":"基于垃圾焚烧行业资本开支25H1为38亿元（-19%），经营性现,推导出垃圾焚烧行业分红潜力提升，24年板块分红比例40%，稳态下分","dimension":"2","confidence":0.9,"is_core":true,"scope":"industry","node_type":"logic"},{"id":"log_9002f3d75b2ce4d3","logic_id":"9002f3d75b2ce4d3","type":"因果","premise":"《意见》要求加强碳排放核算与数据监测，探索自动监测核算。2027年CEA市场将覆盖工业主要排放行业。","conclusion":"碳监测设备需求将随碳市场扩容而增长，聚光科技、雪迪龙等企业直接受益。","text":"基于《意见》要求加强碳排放核算与数据监测，探索自动监测核算。20,推导出碳监测设备需求将随碳市场扩容而增长，聚光科技、雪迪龙等企业直","dimension":"2","confidence":0.9,"is_core":true,"scope":"industry","node_type":"logic"},{"id":"log_ec07159b90efee81","logic_id":"ec07159b90efee81","type":"因果","premise":"2025年1-7月环卫车总销量43967辆（同比+3.3%），新能源销量7095辆（同比+77.55%）","conclusion":"电动化渗透率加速提升，头部企业新能源布局领先","text":"基于2025年1-7月环卫车总销量43967辆（同比+3.3%）,推导出电动化渗透率加速提升，头部企业新能源布局领先","dimension":"2","confidence":0.9,"is_core":true,"scope":"industry","node_type":"logic"},{"id":"log_091893f14f70ec44","logic_id":"091893f14f70ec44","type":"因果","premise":"2025H1垃圾焚烧板块资本开支38亿元（-19%），自由现金流32亿元（24H1为17亿元）。","conclusion":"资本开支下降直接增厚自由现金流，为分红提升提供基础。2024年板块分红比例40%，稳态下潜力达97%-120%。","text":"基于2025H1垃圾焚烧板块资本开支38亿元（-19%），自由现,推导出资本开支下降直接增厚自由现金流，为分红提升提供基础。2024","dimension":"2","confidence":0.85,"is_core":true,"scope":"industry","node_type":"logic"},{"id":"log_1cc3f59fcc077243","logic_id":"1cc3f59fcc077243","type":"因果","premise":"上海环境因政府回购BOT项目获得2105万元税前利润，兴源环境类似交易预计带来2105万元利润","conclusion":"政府回购行为成为环保企业短期利润增长的重要驱动力","text":"基于上海环境因政府回购BOT项目获得2105万元税前利润，兴源环,推导出政府回购行为成为环保企业短期利润增长的重要驱动力","dimension":"2","confidence":0.85,"is_core":true,"scope":"industry","node_type":"logic"},{"id":"log_c412d1ac800208fd","logic_id":"c412d1ac800208fd","type":"递进","premise":"2025/8/22-2025/8/28全国生物柴油均价8400元/吨，环比2025/8/15-2025/8/21生柴均价+1.5%。地沟油均价6544.71元/吨，环比+0.8%。国内UCOME与地沟","conclusion":"生物柴油单吨盈利改善，从111.5元/吨提升至115元/吨，环比+3.1%","text":"生物柴油均价环比+1.5%，地沟油均价环比+0.8%，价差环比+4.1%，考虑一个月库存周期，价差为1989元/吨，环比+0.9%，按照（生物柴油价格-地沟油价格/88%高品质得油率-1000元/吨加工费）测算，单吨盈利为115元/吨（环比+3.1%）","dimension":"2","confidence":0.8,"is_core":true,"scope":"industry","node_type":"logic"},{"id":"log_eab4d4ea3044505a","logic_id":"eab4d4ea3044505a","type":"趋势","premise":"2025M1-7环卫车合计销量43967辆，同比变动+3.3%。其中，新能源环卫车销售7095辆，同比变动+77.55%，新能源渗透率16.14%，同比变动+6.75pct","conclusion":"环卫装备电动化趋势持续，新能源环卫车销量快速增长，渗透率持续提升","text":"从2025M1-7环卫车合计销量43967辆，同比变动+3.3的趋势分析,判断环卫装备电动化趋势持续，新能源环卫车销量快速增长，渗透率持续","dimension":"2","confidence":0.8,"is_core":true,"scope":"industry","node_type":"logic"},{"id":"log_9f1d3eb1f9197e8c","logic_id":"9f1d3eb1f9197e8c","type":"对比","premise":"2025年1-7月宇通重工新能源销量1075辆（占比68%），盈峰环境新能源销量2135辆（市占率30.09%）","conclusion":"宇通重工电动化转型更彻底，盈峰环境传统业务占比仍高","text":"通过对比2025年1-7月宇通重工新能源销量1075辆（占比68%）,得出宇通重工电动化转型更彻底，盈峰环境传统业务占比仍高","dimension":"3","confidence":0.8,"is_core":true,"scope":"entity","node_type":"logic"}],"_indicators":[{"id":"ind_ind_1bb27ec3ec5b","indicator_id":"ind_1bb27ec3ec5b","name":"宇通重工新能源市占率","type":"份额","unit":"%","value":"15.15","is_core":true,"node_type":"indicator"},{"id":"ind_ind_c80491d2973e","indicator_id":"ind_c80491d2973e","name":"宇通重工新能源装备销量占比","type":"份额","unit":"%","value":"68","is_core":true,"node_type":"indicator"},{"id":"ind_ind_0f92e80