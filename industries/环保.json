be\\u7f6e\\u50a8\\u80fd\\u9700\\u6c42\\u7684\\u4e2d\\u6027\\u548c\\u4e50\\u89c2\\u4e24\\u79cd\\u60c5\\u666f\\uff0c\\u6d4b\\u7b97\\u4f9b\\u9700\\u7f3a\\u53e3\\u7684\\u4e0d\\u540c\\u60c5\\u666f\", \"\\u6839\\u636e\\u4f9b\\u9700\\u7f3a\\u53e3\\u53d8\\u5316\\u8d8b\\u52bf\\u5224\\u65ad\\u4ef7\\u683c\\u8d70\\u52bf\\u548c\\u884c\\u4e1a\\u5468\\u671f\\u4f4d\\u7f6e\"]","confidence":0.8,"content":"框架名称：锂资源供需四象限分析框架\n描述：从供给端（海外盐湖、澳矿、海外锂矿、国内锂矿、国内盐湖、回收）和需求端（动力电池、储能电池、小型电池、传统行业）两个维度进行供需平衡预测，引入库存变量调整，计算供需缺口判断市场走势\n核心维度：供给预测, 需求预测, 供需缺口, 价格周期\n步骤：构建供给端分解模型，按地区和技术路线统计各主要矿山/盐湖的产能和产量预测, 构建需求端分解模型，按应用领域统计锂离子电池和传统行业的碳酸锂需求预测, 引入产业链2-4周备货库存变量，计算实际需求与供给的平衡关系, 设置储能需求的中性和乐观两种情景，测算供需缺口的不同情景, 根据供需缺口变化趋势判断价格走势和行业周期位置","is_core":true,"node_type":"framework"},{"id":"fw_fw_236cfdd481094103","name":"全球锂资源供给六分法","type":"methodology","category":"行业分析","industry":"有色金属","steps":"[\"\\u6d77\\u5916\\u76d0\\u6e56\\u677f\\u5757\\u5206\\u6790\\uff1a\\u963f\\u6839\\u5ef7\\u65b0\\u5efa\\u9879\\u76ee\\u722c\\u5761\\u8fdb\\u5ea6\\u3001\\u667a\\u5229SQM\\u548c\\u96c5\\u4fdd\\u6269\\u4ea7\\u8ba1\\u5212\\u3001\\u5df4\\u897f\\u9879\\u76ee\", \"\\u6fb3\\u77ff\\u677f\\u5757\\u5206\\u6790\\uff1aGreenbushes\\u3001Pilgangoora\\u7b49\\u4e3b\\u8981\\u77ff\\u5c71\\u589e\\u91cf\\u9884\\u6d4b\\u3001\\u505c\\u4ea7\\u77ff\\u5c71\\u5f71\\u54cd\", \"\\u975e\\u6d32\\u9502\\u77ff\\u677f\\u5757\\u5206\\u6790\\uff1a\\u4e2d\\u8d44\\u4f01\\u4e1a\\u5728\\u975e\\u9879\\u76ee\\u6295\\u4ea7\\u8fdb\\u5ea6\\u3001\\u6d25\\u5df4\\u5e03\\u97e6\\u548c\\u5c3c\\u65e5\\u5229\\u4e9a\\u8fdb\\u53e3\\u6570\\u636e\", \"\\u56fd\\u5185\\u9502\\u77ff\\u677f\\u5757\\u5206\\u6790\\uff1a\\u6c5f\\u897f\\u77ff\\u8bc1\\u6270\\u52a8\\u3001\\u56db\\u5ddd\\u7532\\u57fa\\u5361\\u548c\\u674e\\u5bb6\\u6c9f\\u3001\\u65b0\\u7586\\u5927\\u7ea2\\u67f3\\u6ee9\\u6295\\u4ea7\", \"\\u56fd\\u5185\\u76d0\\u6e56\\u677f\\u5757\\u5206\\u6790\\uff1a\\u9752\\u6d77\\u5bdf\\u5c14\\u6c57\\u76d0\\u6e56\\u5404\\u4f01\\u4e1a\\u3001\\u897f\\u85cf\\u5404\\u76d0\\u6e56\\u9879\\u76ee\\u89c4\\u5212\\u548c\\u5728\\u5efa\\u8fdb\\u5ea6\", \"\\u56de\\u6536\\u677f\\u5757\\u5206\\u6790\\uff1a\\u5e9f\\u6599\\u56de\\u6536\\u4ea7\\u80fd\\u589e\\u957f\\u5bf9\\u4f9b\\u7ed9\\u7684\\u8865\\u5145\\u4f5c\\u7528\"]","confidence":0.8,"content":"框架名称：全球锂资源供给六分法\n描述：将全球锂资源供给来源分为六大板块进行详细分析和预测：海外盐湖（阿根廷、智利）、澳矿、非洲锂矿、南美其他、 国内锂矿（江西宜春、四川、新疆）、国内盐湖（青海、西藏），评估各板块的增量释放节奏和贡献度\n核心维度：海外盐湖, 澳矿, 非洲锂矿, 国内锂矿, 国内盐湖, 回收\n步骤：海外盐湖板块分析：阿根廷新建项目爬坡进度、智利SQM和雅保扩产计划、巴西项目, 澳矿板块分析：Greenbushes、Pilgangoora等主要矿山增量预测、停产矿山影响, 非洲锂矿板块分析：中资企业在非项目投产进度、津巴布韦和尼日利亚进口数据, 国内锂矿板块分析：江西矿证扰动、四川甲基卡和李家沟、新疆大红柳滩投产, 国内盐湖板块分析：青海察尔汗盐湖各企业、西藏各盐湖项目规划和在建进度, 回收板块分析：废料回收产能增长对供给的补充作用","is_core":true,"node_type":"framework"}],"_relatedEntities":[{"id":"ent_8cccf07d84b8","name":"海螺创业","type":"ORG","relations":["对比","合作","竞争"],"relation_count":3,"description":"绿色动力25H1归母净利润同比增长24%至3.77亿元，海螺创业同期归母净利润12.86亿元同比增长9.33%，两家企业在垃圾焚烧发电市场的运营规模和盈利能力上形成竞争对比","dir":"out","descriptions":["绿色动力2025H1归母净利润同比增长24%至3.77亿元，海螺创业同比增长9.33%至12.86亿元，两者均在固废领域实现稳健增长，在业务模式和盈利能力上形成对标","绿色动力与海螺创业在垃圾焚烧供热业务上形成竞争，绿色动力25H1供汽量51.38万吨同比+115%，海螺创业供热量31.3万吨同比+170%","绿色动力25H1归母净利润同比增长24%至3.77亿元，海螺创业同期归母净利润12.86亿元同比增长9.33%，两家企业在垃圾焚烧发电市场的运营规模和盈利能力上形成竞争对比"]},{"id":"ent_4ceac5326ad0","name":"瀚蓝环境","type":"ORG","relations":["竞争","合作","收购"],"relation_count":3,"description":"瀚蓝环境于2025年6月完成对粤丰环保的并表，持股52.44%贡献归母0.6亿元，与绿色动力在垃圾焚烧运营领域形成直接竞争关系，两家公司均为A股/H股上市的重点推荐标的","dir":"in","descriptions":["瀚蓝环境与绿色动力同属垃圾焚烧板块，在运营规模、ROE水平、分红能力等方面形成直接竞争，瀚蓝环境分红比例39.20%，绿色动力71.45%，争夺市场份额和投资者青睐","瀚蓝环境与绿色动力同属垃圾焚烧板块龙头企业，均实现2025H1归母净利润同比增长，两者在降本增效、供热业务拓展方面展开竞争","瀚蓝环境于2025年6月完成对粤丰环保的并表，持股52.44%贡献归母0.6亿元，与绿色动力在垃圾焚烧运营领域形成直接竞争关系，两家公司均为A股/H股上市的重点推荐标的"]},{"id":"ent_decb382e92d6","name":"垃圾焚烧","type":"INDUSTRY","relations":["战略联盟"],"relation_count":1,"description":"绿色动力通过掺烧污泥、供汽量增加（25H1供汽量51.38万吨同比增长115%）、渗滤液沼气提纯销售实现多元化增收，25H1归母净利润同比增长24%","dir":"out","descriptions":["绿色动力通过掺烧污泥、供汽量增加（25H1供汽量51.38万吨同比增长115%）、渗滤液沼气提纯销售实现多元化增收，25H1归母净利润同比增长24%"]},{"id":"ent_1cfb1bf9662b","name":"永兴股份","type":"ORG","relations":["对比"],"re