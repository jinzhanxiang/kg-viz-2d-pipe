\u53e3\\u7ba1\\u5236\\u3001\\u4ea7\\u80fd\\u914d\\u989d\\u3001\\u73af\\u4fdd\\u653f\\u7b56\\u7b49\\u5bf9\\u4f9b\\u7ed9\\u7aef\\u7684\\u6270\\u52a8\\u7a0b\\u5ea6\"]","confidence":0.8,"content":"框架名称：有色金属供需结构四维分析框架\n描述：从供给刚性、需求弹性、库存周期、政策扰动四个维度评估有色金属各品种投资价值，供给端关注资本开支周期与产能投放节奏，需求端区分新能源增量与传统领域占比，库存端监测显性库存与社会库存变化，政策端跟踪出口管制与配额调整。\n适用场景：有色金属各品种供需格局对比分析、投资机会筛选\n核心维度：供给刚性、需求弹性、库存周期、政策扰动\n步骤：供给维度：分析各品种资本开支高峰是否已过，判断2025-2027年新增产能释放节奏, 需求维度：区分内销与出口需求结构，测算新能源领域（储能、光伏、电动车）对各品种的需求拉动, 库存维度：监测全球显性库存与交易所库存变化，判断供需缺口收窄或扩大趋势, 政策维度：跟踪出口管制、产能配额、环保政策等对供给端的扰动程度","is_core":true,"node_type":"framework"},{"id":"fw_fw_1641bc4662d0","name":"AI电力需求与储能发展框架","type":"opportunity","category":"市场分析","industry":"消费/食品饮料","steps":"[\"\\u5206\\u6790\\u6570\\u636e\\u4e2d\\u5fc3\\u5efa\\u8bbe\\u5468\\u671f\\uff1a\\u8fdc\\u5feb\\u4e8e\\u7535\\u7f51\\u6269\\u5bb9\\uff0c\\u71c3\\u6c14\\u8f6e\\u673a\\u4ea7\\u80fd\\u7d27\\u7f3a\\uff0c\\u6838\\u7535\\u5efa\\u8bbe\\u5468\\u671f\\u6162\", \"\\u5206\\u6790\\u4f20\\u7edf\\u80fd\\u6e90vs\\u98ce\\u5149\\u50a8\\u5efa\\u8bbe\\u5468\\u671f\\uff1a\\u706b\\u75353-4\\u5e74\\u3001\\u6c34\\u7535\\u8d857\\u5e74\\u3001\\u6838\\u7535\\u89c6\\u8fd16\\u5e74\\u3001\\u98ce\\u5149\\u50a8\\u4e00\\u4f53\\u53161-3\\u5e74\", \"\\u5206\\u6790136\\u53f7\\u6587\\u5f71\\u54cd\\uff1a\\u4ece\\u56fa\\u5b9a\\u8131\\u786b\\u7164\\u6807\\u6746\\u7535\\u4ef7\\u8f6c\\u4e3a\\u6ce2\\u52a8\\u5e02\\u573a\\u5316\\u4ea4\\u6613\\u7535\\u4ef7\\uff0c\\u50a8\\u80fd\\u6210\\u4e3a\\u5bf9\\u6297\\u7535\\u4ef7\\u6ce2\\u52a8\\u7684\\u5fc5\\u8981\\u5de5\\u5177\", \"\\u5206\\u6790\\u50a8\\u80fd\\u7cfb\\u7edf\\u964d\\u4ef7\\uff1a2024\\u5e74\\u9502\\u7535\\u50a8\\u80fdEPC\\u4e2d\\u6807\\u5747\\u4ef71.175\\u5143/\\u74e6\\u65f6\\u540c\\u6bd4\\u4e0b\\u964d16.07%\", \"\\u5206\\u6790LPR\\u4e0b\\u964d\\uff1a1\\u5e74\\u671f\\u548c5\\u5e74\\u671f\\u4ee5\\u4e0aLPR\\u5206\\u522b\\u964d\\u81f33.0%\\u548c3.5%\\uff0c\\u63d0\\u9ad8\\u50a8\\u80fd\\u7535\\u7ad9\\u7ecf\\u6d4e\\u6027\"]","confidence":0.8,"content":"框架名称：AI电力需求与储能发展框架\n描述：分析AI数据中心电力需求暴增对传统能源建设周期的冲击，储能作为快速部署方案的优势，136号文推动储能市场化转型的机遇。\n适用场景：全球能源结构转型与数据中心电力需求分析\n核心维度：电力短缺、储能经济性、市场化转型\n步骤：分析数据中心建设周期：远快于电网扩容，燃气轮机产能紧缺，核电建设周期慢, 分析传统能源vs风光储建设周期：火电3-4年、水电超7年、核电视近6年、风光储一体化1-3年, 分析136号文影响：从固定脱硫煤标杆电价转为波动市场化交易电价，储能成为对抗电价波动的必要工具, 分析储能系统降价：2024年锂电储能EPC中标均价1.175元/瓦时同比下降16.07%, 分析LPR下降：1年期和5年期以上LPR分别降至3.0%和3.5%，提高储能电站经济性","is_core":true,"node_type":"framework"}],"_relatedEntities":[{"id":"ent_eb3303f5befa","name":"马士基","type":"ORG","relations":["投资"],"relation_count":1,"description":"马士基投资船舶废气净化系统研发，通过碳捕集技术减少现有船队排放，作为过渡期减排措施","dir":"in","descriptions":["马士基投资船舶废气净化系统研发，通过碳捕集技术减少现有船队排放，作为过渡期减排措施"]},{"id":"ent_4ba1699a487b","name":"航运物流行业","type":"INDUSTRY","relations":["技术链"],"relation_count":1,"description":"碳捕集技术成为航运业实现净零排放的技术路径之一","dir":"out","descriptions":["碳捕集技术成为航运业实现净零排放的技术路径之一"]}],"_reports":[{"report_id":"rpt_f355f130697a","title":"2025-10-11-荣续ESG智库研究中心-物流及航运物流行业ESG白皮书_49页_.pdf","source":"券商研报","publish_date":"2024-06-15","industry":"消费/食品饮料"}]},{"id":"ent_5c833944c9ee","name":"碳排放权交易市场","type":"INDUSTRY","industry":"环保","desc":"全国碳排放权交易市场于2021年7月16日正式启动交易，成为全球覆盖碳排放规模最大的碳市场。目前覆盖发电行业控排企业2162家，控排企业年排放量超过40亿吨二氧化碳，占全国碳排放比例超40%，超过欧盟碳市场2019年覆盖的约19亿吨二氧化碳排放量。","is_core":false,"node_type":"entity","typeLabel":"INDUSTRY","sector":"环保","subIndustry":"","color":"","core":false,"importance":0,"publishDate":"","val":4,"description":"全国碳排放权交易市场于2021年7月16日正式启动交易，成为全球覆盖碳排放规模最大的碳市场。目前覆盖发电行业控排企业2162家，控排企业年排放量超过40亿吨二氧化碳，占全国碳排放比例超40%，超过欧盟碳市场2019年覆盖的约19亿吨二氧化碳排放量。","_logicRefs":[{"id":"log_a75faaceff479e79","logic_id":"a75faaceff479e79","type":"因果","premise":"各地政府陆续发布强制配储需求，配储比例最高可达30%；若风光装机量达到50亿千瓦、年发电量10万亿度时，按10%-30%的配储比例，储能容量将在1万亿-3万亿度","conclusion":"储能必须满足低成本、规模化、无地域限制、长寿命等要求，氢能作为长周期储能的重要方式将迎来放量","text":"基于各地政府陆续发布强制配储需求，配储比例最高可达30%；若风光,推导出储能必须满足低成本、规模化、无地域限制、长寿命等要求，氢能作","dimension":"2","confidence":0.95,"is_core":true,"scope":"industry","node_type":"logic"},{"id":"log_283589ab669a00fb","logic_id":"283589ab669a00fb","type":"对比","premise":"1吨煤发电3333kWh，排放2.62吨