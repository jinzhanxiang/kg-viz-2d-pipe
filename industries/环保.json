\u6790\\uff1a\\u5e9f\\u6599\\u56de\\u6536\\u4ea7\\u80fd\\u589e\\u957f\\u5bf9\\u4f9b\\u7ed9\\u7684\\u8865\\u5145\\u4f5c\\u7528\"]","confidence":0.8,"content":"框架名称：全球锂资源供给六分法\n描述：将全球锂资源供给来源分为六大板块进行详细分析和预测：海外盐湖（阿根廷、智利）、澳矿、非洲锂矿、南美其他、 国内锂矿（江西宜春、四川、新疆）、国内盐湖（青海、西藏），评估各板块的增量释放节奏和贡献度\n核心维度：海外盐湖, 澳矿, 非洲锂矿, 国内锂矿, 国内盐湖, 回收\n步骤：海外盐湖板块分析：阿根廷新建项目爬坡进度、智利SQM和雅保扩产计划、巴西项目, 澳矿板块分析：Greenbushes、Pilgangoora等主要矿山增量预测、停产矿山影响, 非洲锂矿板块分析：中资企业在非项目投产进度、津巴布韦和尼日利亚进口数据, 国内锂矿板块分析：江西矿证扰动、四川甲基卡和李家沟、新疆大红柳滩投产, 国内盐湖板块分析：青海察尔汗盐湖各企业、西藏各盐湖项目规划和在建进度, 回收板块分析：废料回收产能增长对供给的补充作用","is_core":true,"node_type":"framework"}],"_relatedEntities":[{"id":"ent_4ceac5326ad0","name":"瀚蓝环境","type":"ORG","relations":["战略联盟","收购"],"relation_count":2,"description":"瀚蓝环境于2025年6月完成对粤丰环保的并表，持股52.44%，6月单月贡献归母净利润0.6亿元，通过M&A方式扩大垃圾焚烧运营规模，提升行业地位","dir":"in","descriptions":["瀚蓝环境通过供热和IDC合作等方式降本增效，25H1内生供热量91.20万吨同比增长40%，供热收入1.34亿元同比增长40%","瀚蓝环境于2025年6月完成对粤丰环保的并表，持股52.44%，6月单月贡献归母净利润0.6亿元，通过M&A方式扩大垃圾焚烧运营规模，提升行业地位"]},{"id":"ent_f01c89b2114e","name":"全国碳市场建设意见","type":"POLICY","relations":["监管"],"relation_count":1,"description":"《意见》明确碳排放配额总量控制，有序扩大覆盖行业范围，化石能源发电环境成本被内部化，垃圾发电不产生直接碳排放的零碳属性价值凸显，利好垃圾焚烧绿电资产价值重估","dir":"in","descriptions":["《意见》明确碳排放配额总量控制，有序扩大覆盖行业范围，化石能源发电环境成本被内部化，垃圾发电不产生直接碳排放的零碳属性价值凸显，利好垃圾焚烧绿电资产价值重估"]},{"id":"ent_18d10a87c62b","name":"绿色动力","type":"ORG","relations":["战略联盟"],"relation_count":1,"description":"绿色动力通过掺烧污泥、供汽量增加（25H1供汽量51.38万吨同比增长115%）、渗滤液沼气提纯销售实现多元化增收，25H1归母净利润同比增长24%","dir":"in","descriptions":["绿色动力通过掺烧污泥、供汽量增加（25H1供汽量51.38万吨同比增长115%）、渗滤液沼气提纯销售实现多元化增收，25H1归母净利润同比增长24%"]}],"_reports":[{"report_id":"rpt_952a771c4256","title":"东吴证券-环保行业跟踪周报_固废提质增效_现金流改善逻辑持续兑现_加强全国碳市场建设碳约束趋严_32页_2mb","source":"券商研报","publish_date":"2025-09-02","industry":"有色金属/锂"}]},{"id":"ent_961b77acaf1b","name":"垃圾焚烧板块","type":"INDUSTRY","industry":"环保","desc":"2025H1营收232亿元（+1%），归母净利润51亿元（+8%）。期间费用率12.7%（-0.3pct），财务费用率5.3%（-0.6pct）。经营性现金流净额69亿元（+9%），资本开支38亿元（-19%），自由现金流32亿元（2024H1为17亿元）。","is_core":true,"node_type":"entity","typeLabel":"INDUSTRY