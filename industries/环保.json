_architecture","category":"行业分析","industry":"电力设备/储能","steps":"[\"\\u53d8\\u5316\\u4e00\\uff1a\\u7535\\u529b\\u73b0\\u8d27\\u5cf0\\u8c37\\u4ef7\\u5dee\\u662f\\u6bd4\\u62db\\u6807\\u6570\\u636e\\u66f4\\u524d\\u77bb\\u7684\\u666f\\u6c14\\u5ea6\\u6307\\u6807\\uff0c\\u9700\\u8ddf\\u8e2a\\u5404\\u7701\\u4ef7\\u5dee\\u6570\\u636e\", \"\\u53d8\\u5316\\u4e8c\\uff1a\\u5bb9\\u91cf\\u8865\\u507f\\u673a\\u5236\\u843d\\u5730\\u8fdb\\u5ea6\\u5f71\\u54cd\\u50a8\\u80fd\\u7b2c\\u4e8c\\u5927\\u6536\\u5165\\u6765\\u6e90\\uff0c\\u9700\\u5173\\u6ce8\\u5404\\u7701\\u653f\\u7b56\\u63a8\\u8fdb\", \"\\u53d8\\u5316\\u4e09\\uff1aAIDC\\u914d\\u50a8\\u9879\\u76ee\\u843d\\u5730\\u8fdb\\u5c55\\u662f\\u7f8e\\u56fd\\u5e02\\u573a\\u8d85\\u9884\\u671f\\u7684\\u5173\\u952e\\u53d8\\u91cf\", \"\\u53d8\\u5316\\u56db\\uff1a\\u6b27\\u6d32MACSE\\u3001\\u4fdd\\u5e95\\u6536\\u76ca\\u7b49\\u673a\\u5236\\u521b\\u65b0\\u63a8\\u52a8\\u6b27\\u6d32\\u6210\\u4e3a\\u6d77\\u5916\\u7b2c\\u4e00\\u5927\\u589e\\u91cf\\u5e02\\u573a\", \"\\u53d8\\u5316\\u4e94\\uff1a\\u78b3\\u9178\\u9502\\u4ef7\\u683c\\u4e0e\\u50a8\\u80fd\\u7ecf\\u6d4e\\u6027\\u4e92\\u4e3a\\u56e0\\u679c\\uff0c\\u9700\\u5173\\u6ce8\\u5e73\\u8861\\u70b9\"]","confidence":0.8,"content":"框架名称：储能行业五大变化跟踪框架\n描述：通过跟踪电力现货市场峰谷价差、容量补偿机制推进、AIDC配储项目落地、欧洲大储机制创新、上游原材料价格五大维度，构建储能行业景气度跟踪体系。\n适用场景：储能行业投资决策、行业景气度判断\n核心维度：电力现货市场|容量补偿|AIDC|欧洲大储|碳酸锂价格\n步骤：变化一：电力现货峰谷价差是比招标数据更前瞻的景气度指标，需跟踪各省价差数据, 变化二：容量补偿机制落地进度影响储能第二大收入来源，需关注各省政策推进, 变化三：AIDC配储项目落地进展是美国市场超预期的关键变量, 变化四：欧洲MACSE、保底收益等机制创新推动欧洲成为海外第一大增量市场, 变化五：碳酸锂价格与储能经济性互为因果，需关注平衡点","is_core":true,"node_type":"framework"},{"id":"fw_fw_61a61ebaec56","name":"储能长期空间测算框架","type":"logic","category":"行业分析","industry":"电力设备/储能","steps":"[\"\\u7b2c\\u4e00\\u6b65\\uff1a\\u786e\\u5b9a\\u5df4\\u9ece\\u534f\\u5b9aNDCs\\u76ee\\u6807\\u7ea6\\u675f\\uff0c\\u4e2d\\u7f8e\\u6b272035\\u5e74\\u78b3\\u6392\\u653e\\u76ee\\u6807\\u660e\\u786e\", \"\\u7b2c\\u4e8c\\u6b65\\uff1a\\u63a8\\u5bfc\\u98ce\\u5149\\u50a8\\u5e74\\u65b0\\u589e\\u88c5\\u673a\\u5cf0\\u503c\\u51fa\\u73b0\\u57282035\\u5e74\\u5de6\\u53f3\", \"\\u7b2c\\u4e09\\u6b65\\uff1a\\u6d4b\\u7b97\\u50a8\\u80fd\\u88c5\\u673a\\u5929\\u82b1\\u677f\\u500d\\u6570\\u548c\\u51fa\\u8d27\\u91cf\\u5cf0\\u503c\", \"\\u7b2c\\u56db\\u6b65\\uff1a\\u8ba1\\u7b972024-2035\\u5e74CAGR\\u9a8c\\u8bc1\\u589e\\u957f\\u786e\\u5b9a\\u6027\"]","confidence":0.8,"content":"框架名称：储能长期空间测算框架\n描述：基于巴黎协定NDCs框架和双碳目标，从终局思维出发，通过能源转型→双碳目标→风光需求→储能需求的逻辑链条测算长期空间。\n适用场景：储能市场规模预测、长期空间判断\n核心维度：NDCs目标|风光装机|储能需求|CAGR\n步骤：第一步：确定巴黎协定NDCs目标约束，中美欧2035年碳排放目标明确, 第二步：推导风光储年新增装机峰值出现在2035年左右, 第三步：测算储能装机天花板倍数和出货量峰值, 第四步：计算2024-2035年CAGR验证增长确定性","is_core":true,"node_type":"framework"}],"_relatedEntities":[{"id":"ent_2d46283eb364","name":"巴黎协定","type":"POLICY","relations":["监管"],"relation_count":1,"description":"《巴黎协定》具有法律约束力，设定全球温升控制目标，要求各国以5年为周期发布国家自主贡献NDCs，通过棘轮机制推动各国逐步升级减排承诺","dir":"in","descriptions":["《巴黎协定》具有法律约束力，设定全球温升控制目标，要求各国以5年为周期发布国家自主贡献NDCs，通过棘轮机制推动各国逐步升级减排承诺"]}],"_reports":[{"report_id":"rpt_4713855bda37","title":"2026年全球储能发展趋势_混沌中寻找确定性_26页_2mb","source":"券商研报","publish_date":"2026-01-23","industry":"电力设备/储能"}]},{"id":"ent_a3d8edef74fc","name":"东方园林","type":"ORG","industry":"环保","desc":"股上市的园林龙头，2009年12月31日至2011年1月31日区间涨幅183%；2013年5月30日至2014年4月25日区间跌幅43%；2017年4月12日至2021年2月10日区间跌幅79.6%。","is_core":false,"node_type":"entity","typeLabel":"ORG","sector":"环保","subIndustry":"","color":"","core":false,"importance":0,"publishDate":"","val":4,"description":"股上市的园林龙头，2009年12月31日至2011年1月31日区间涨幅183%；2013年5月30日至2014年4月25日区间跌幅43%；2017年4月12日至2021年2月10日区间跌幅79.6%。","_logicRefs":[{"id":"log_8c6173fc4090c002","logic_id":"8c6173fc4090c002","type":"趋势","premise":"2014-2015年大建筑央企平均涨幅505%，国际工程公司平均涨幅125%；2017年国际工程公司平均涨幅39%；2019年国际工程公司平均涨幅58%；2023年八大央企/四大国际工程公司分别平均涨","conclusion":"一带一路主题行情主要集中在国际工程公司，市值越小涨幅越大","text":"从2014-2015年大建筑央企平均涨幅505%，国际工程公司的趋势分析,判断一带一路主题行情主要集中在国际工程公司，市值越小涨幅越大","dimension":"2","confidence":0.95,"is_core":true,"scope":"industry","node_type":"logic"},{"id":"log_cbd8233d06c33f21","logic_id":"cbd8233d06c33f21","type":"因果","premise":"2008年底四万亿政策后板块估值从25倍修复至50倍；2014年下半年开始的宽松周期叠加一带一路主题板块最高上涨421%；2024年9月政策大幅加码后板块反弹38%跑赢沪深300 16pct","conclusion":"政策宽松周期中降准降息、放松融资平台管控有利于建筑企业融资，基建及地产基本面预期改善","text":"基于2008年底四万亿政策后板块估值从25倍修复至50倍；201,推导出政策宽松周期中降准降息、放松融资平台管控有利于建筑企业融资，","dimension":"2","confidence":0.95,"is_core":true,"scope":"industry","node_type":"logic"},{"id":"log_001684d721ad4094","logic_id":"001684d721ad4094","type":"因果","premise":"建筑板块16年行情中，2008年6月至2024年12月分为15个阶段，跑赢阶段8个占比40%、跑输阶段7个占比60%。8个跑赢阶段中7个处于宽松周期（2008年底-2010年初、2011年底-2013","conclusion":"政策周期是决定建筑板块能否获得超额收益的关键因素，宽松周期内板块大概率跑赢，紧缩周期内大概率跑输","text":"从15个阶段的宏观背景看，政策宽松期通常采取降准降息、放松融资平台管控等措施，2008年四万亿、2011-2013年稳增长、2014-2017年超级宽松、2021年至今渐进式宽松对应的阶段七（超额收益188%）、阶段九（超额收益37%）、阶段十一（超额收益61%）均为跑赢阶段；而2010-2011年紧缩期（阶段三、四）出现明显超额收益时需叠加业绩爆发","dimension":"2","confidence":0.92,"is_core":true,"scope":"industry","node_type":"logic"},{"id":"log_ada48d564a8a30e2","logic_id":"ada48d564a8a30e2","type":"递进","premise":"2022年11月提出、2023年1月主升浪、2023年5月扩散、2023年8月利好兑现","conclusion":"中特估主题经历提出→主升浪→扩散震荡→利好兑现四个阶段","text":"基于2022年11月提出、2023年1月主升浪、2023年5月扩,推导出中特估主题经历提出→主升浪→扩散震荡→利好兑现四个阶段","dimension":"2","confidence":0.9,"is_core":false,"scope":"industry","node_type":"logic"},{"id":"log_ccd1458fd429d81c","logic_id":"ccd1458fd429d81c","type":"因果","premise":"2017年4月第一届论坛、2019年4月第二届论坛、2023年10月第三届论坛","conclusion":"2017年第一届、2019年第二届、2023年第三届论坛前后均有明显一带一路主题行情","text":"基于2017年4月第一届论坛、2019年4月第二届论坛、2023,推导出2017年第一届、2019年第二届、2023年第三届论坛前后","dimension":"2","confidence":0.9,"is_core":false,"scope":"industry","node_type":"logic"},{"id":"log_3572aaefa2bf399e","logic_id":"3572aaefa2bf399e","type":"递进","premise":"2022年11月证监会主席提出中特估；2023年1月国资委将考核改为\"一利五率\"加入ROE和营业现金比率","conclusion":"中特估通过央企考核改革落地，与一带一路十周年叠加形成2023年初重要投资主线","text":"基于2022年11月证监会主席提出中特估；2023年1月国资委将,推导出中特估通过央企考核改革落地，与一带一路十周年叠加形成2023","dimension":"2","confidence":0.9,"is_core":true,"scope":"industry","node_type":"logic"},{"id":"log_4254f1c11b59cec2","logic_id":"4254f1c11b59cec2","type":"因果","premise":"通过图表37数据观察，15个超额收益阶段中固投增速多为负值或下降；基建投增速、地产投增速与超额ROI均呈反向波动；这说明市场在投数据下降时提前预期政策转向","conclusion":"当固定资产投资增速持续下降时，市场预期政府将逆周期加大投资稳增长，从而产生建筑板块超额行情","text":"基于通过图表37数据观察，15个超额收益阶段中固投增速多为负值或,推导出当固定资产投资增速持续下降时，市场预期政府将逆周期加大投资稳","dimension":"2","confidence":0.9,"is_core":true,"scope":"industry","node_type":"logic"},{"id":"log_37dbad5bd5dec049","logic_id":"37dbad5bd5dec049","type":"趋势","premise":"2014年后板块整体收入与业绩波动较小，而股价波动较大，主要受主题影响。2014年末-2015年中一带一路主题行情出现在政策宽松周期内，板块区间最高上涨421%、相对沪深300超额收益293%，大建筑","conclusion":"主题催化是建筑板块获取高弹性超额收益的重要来源，在政策宽松环境下叠加低估值，主题行情放大效应显著","text":"一带一路主题行情分为四段：1）2014年3月-2015年5月战略提出叠加牛市，板块最高涨421%超额293%，大建筑央企平均涨505%；2）2017年1月-4月第一届论坛行情，四大国际工程公司平均涨39%；3）2018年11月-2019年4月第二届论坛行情，四大国际工程公司平均涨58%；4）2022年11月-2023年5月第三届论坛叠加中特估，板块涨57%超额46%。中特估行情：2023年1月-4","dimension":"2","confidence":0.9,"is_core":true,"scope":"industry","node_type":"logic"}],"_indicators":[],"_frameworks":[{"id":"fw_fw_1747310df936","name":"美妆行业未来趋势展望分析框架","type":"opportunity","category":"行业分析","industry":"金融-主题研究","steps":"[\"1.\\u5206\\u6790\\u9700\\u6c42\\u7aef\\u4e09\\u5927\\u7279\\u5f81\\u53ca\\u5176\\u5bf9\\u4ea7\\u54c1\\u5f00\\u53d1\\u7684\\u5f71\\u54cd\\uff1b2.\\u7814\\u7a76\\u4f9b\\u7ed9\\u7aef\\u7ade\\u4e89\\u683c\\u5c40\\u6f14\\u53d8\\u4e0e\\u5168\\u7403\\u5316\\u8def\\u5f84\\uff1b3.\\u8bc4\\u4f30\\u751f\\u7269\\u79d1\\u6280\\u3001\\u6570\\u5b57\\u6280\\u672f\\u5bf9\\u7814\\u53d1\\u6a21\\u5f0f\\u7684\\u98a0\\u8986\\uff1b4.\\u63d0\\u51fa\\u884c\\u4e1a\\u6295\\u8d44\\u7b56\\u7565\\u5efa\\u8bae\"]","confidence":0.8,"content":"框架名称：美妆行业未来趋势展望分析框架\n描述：从需求端、供给端、科技端三大维度展望2026-2030年中国美妆行业趋势：需求端关注功效深化、场景细分、文化赋能；供给端关注集中度提升、跨界融合、全球布局；科技端关注生物科技、数字技术的融合应用\n适用场景：分析中国化妆品行业未来五年发展趋势与投资机会\n核心维度：需求趋势,供给变革,技术突破,竞争格局\n步骤：1.分析需求端三大特征及其对产品开发的影响；2.研究供给端竞争格局演变与全球化路径；3.评估生物科技、数字技术对研发模式的颠覆；4.提出行业投资策略建议","is_core":true,"node_type":"framework"},{"id":"fw_fw_b359e6da94af","name":"技术融合驱动产品创新框架","type":"methodology","category":"技术分析","industry":"金融-主题研究","steps":"[\"\\u68b3\\u7406\\u4e09\\u5927\\u6280\\u672f\\u9886\\u57df\\u7a81\\u7834\\uff1a