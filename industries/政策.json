[{"id":"ent_c723dd29ac2b","name":"中央预算内资金","type":"POLICY","industry":"政策","desc":"中央预算内资金是中央政府直接拨付的无偿资金，2025年拟安排7350亿元，比上一年增加350亿元。低空经济项目可申报该资金，用于核心技术攻关（如无人机导航避障系统、eVTOL动力电池）及新型基础设施（如无人机起降场点、低空智联网平台）。申报主体为政府或企事业单位，时间通常在第一季度或第四季度。","is_core":true,"node_type":"entity","typeLabel":"POLICY","sector":"政策","subIndustry":"","color":"","core":true,"importance":0,"publishDate":"","val":4,"_logicRefs":[],"_indicators":[],"_frameworks":[],"_relatedEntities":[]},{"id":"ent_078bbad5d97c","name":"可持续发展报告指引","type":"POLICY","industry":"政策","desc":"2024年4月由沪深北三大交易所联合发布，建立环境披露框架，强制上证180、科创50等指数样本公司2026年前发布报告，参照TCFD框架披露范围1和范围2温室气体排放量。","is_core":true,"node_type":"entity","typeLabel":"POLICY","sector":"政策","subIndustry":"","color":"","core":true,"importance":0,"publishDate":"","val":4,"_logicRefs":[],"_indicators":[],"_frameworks":[],"_relatedEntities":[]},{"id":"ent_e654e4f47e0d","name":"特朗普","type":"PERSON","industry":"政策","desc":"美国总统，多次批评美联储降息过慢。推动‘对等关税’政策，逆全球化之风兴起。2025年4月威胁对欧盟进口货物征收30%关税，目标包括钢铁、铝、汽车等领域。2026年进入中期选举年，政策不确定性或边际降温，重心向国内倾斜。其关税政策对全球贸易和中国出口造成扰动，但也促使中国出口目的地多元化。","is_core":true,"node_type":"entity","typeLabel":"PERSON","sector":"政策","subIndustry":"","color":"","core":true,"importance":0,"publishDate":"","val":4,"_logicRefs":[],"_indicators":[],"_frameworks":[],"_relatedEntities":[]},{"id":"ent_b51adeb21c4a","name":"特朗普政府","type":"ORG","industry":"政策","desc":"美国现任政府，通过多种方式施压美联储降息，包括公开呼吁、干预人事任命等手段。","is_core":true,"node_type":"entity","typeLabel":"ORG","sector":"政策","subIndustry":"","color":"","core":true,"importance":0,"publishDate":"","val":4,"_logicRefs":[],"_indicators":[],"_frameworks":[],"_relatedEntities":[]},{"id":"ent_347adb201370","name":"行业投资评级体系","type":"POLICY","industry":"政策","desc":"东莞证券定义的行业投资评级体系分为三级：超配（预计未来6个月内行业指数表现强于市场指数10%以上）、标配（介于市场指数±10%之间）、低配（弱于市场指数10%以上）。该体系用于判断各行业板块的相对配置价值。","is_core":true,"node_type":"entity","typeLabel":"POLICY","sector":"政策","subIndustry":"","color":"","core":true,"importance":0,"publishDate":"","val":4,"_logicRefs":[],"_indicators":[],"_frameworks":[],"_relatedEntities":[]},{"id":"ent_7b8bbaae47a1","name":"国资备案","type":"POLICY","industry":"政策","desc":"国资备案是方案三（非上市公司现金收购）中面临的难点。评估报告在国资备案中可能面临挑战，如收购估值较高而业绩不及预期，后续可能无法注入上市公司。天保控股作为国有企业，需遵守国资监管规定。","is_core":false,"node_type":"entity","typeLabel":"POLICY","sector":"政策","subIndustry":"","color":"","core":false,"importance":0,"publishDate":"","val":4,"_logicRefs":[],"_indicators":[],"_frameworks":[],"_relatedEntities":[]},{"id":"ent_9947a216d4c0","name":"美国WRO","type":"POLICY","industry":"政策","desc":"美国维吾尔强迫劳动预防法，目前已实施。覆盖范围针对特定地区及产品链条，核心机制为进口端扣留、举证与排除。对企业影响是对特定地区或链条形成实质限制，迫使出口企业调整市场策略，加强合规证明与供应链透明度。","is_core":false,"node_type":"entity","typeLabel":"POLICY","sector":"政策","subIndustry":"","color":"","core":false,"importance":0,"publishDate":"","val":4,"_logicRefs":[],"_indicators":[],"_frameworks":[],"_relatedEntities":[]},{"id":"ent_0f0de78719de","name":"跨界并购监管","type":"POLICY","industry":"政策","desc":"跨界并购监管是天保基建收购星恒电源面临的主要政策风险。监管机构可能从审慎性角度业绩对赌。2026年3月沙河股份（000014.SZ）已完成跨界重大资产重组（现金类），为天保基建提供先例参考。","is_core":false,"node_type":"entity","typeLabel":"POLICY","sector":"政策","subIndustry":"","color":"","core":false,"importance":0,"publishDate":"","val":4,"_logicRefs":[],"_indicators":[],"_frameworks":[],"_relatedEntities":[]}]