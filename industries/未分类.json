[{"id":"ent_896b028a4ccb","name":"ESG治理体系","type":"TECH","industry":"未分类","desc":"包含环境（E）、社会（S）、治理（G）三维度的企业可持续发展框架，2024年沪深北交易所《可持续发展报告指引》强制披露范围1和范围2温室气体排放量，2025年财政部《气候准则》征求意见稿采用六章四十七条体例构建专项披露规范。","is_core":true,"node_type":"entity","typeLabel":"TECH","sector":"未分类","subIndustry":"","color":"","core":true,"importance":0,"publishDate":"","val":4,"_logicRefs":[],"_indicators":[],"_frameworks":[],"_relatedEntities":[]},{"id":"ent_2c86bfcafb6e","name":"万得微盘股指数","type":"PRODUCT","industry":"未分类","desc":"衡量微盘股表现的核心基准指数。截至2025年Q2，公募基金全部持仓持有该指数成分股市值约为114亿元，占其流通市值比例为1.59%，较2024年Q4上升66bp。该指数成分股的前十大股东中，有公募基金持股的流通市值约为34.55亿元，占该指数总流通市值的0.48%，历史最低为0.07%。","is_core":true,"node_type":"entity","typeLabel":"PRODUCT","sector":"未分类","subIndustry":"","color":"","core":true,"importance":0,"publishDate":"","val":4,"_logicRefs":[],"_indicators":[],"_frameworks":[],"_relatedEntities":[]},{"id":"ent_520710820182","name":"中小企业决策者","type":"PERSON","industry":"未分类","desc":"调查显示，这些决策者在招聘观点上保持相对稳定，38%认为购买AI软件比雇佣新员工更昂贵，但44%认为AI可以替代员工职责。此外，52%的非用户决策者计划在2025年底前开始采用AI技术。","is_core":true,"node_type":"entity","typeLabel":"PERSON","sector":"未分类","subIndustry":"","color":"","core":true,"importance":0,"publishDate":"","val":4,"_logicRefs":[],"_indicators":[],"_frameworks":[],"_relatedEntities":[]},{"id":"ent_148bdcb2cc00","name":"颅内复读机","type":"PRODUCT","industry":"未分类","desc":"七大爆款旋律类型之一，核心为抽象洗脑与空耳玩梗。抖音平台上#抽象相关内容播放量3793亿次，#发疯日常874亿次。代表旋律如《哈基米陷阱BEAT》（643.7万人使用）、《跳楼机》。主要触达“抽象梗学家”人群，通过无厘头重复片段、廉价电子琴音色，适配反差搞笑、沙雕整活类内容，实现病毒式传播。","is_core":true,"node_type":"entity","typeLabel":"PRODUCT","sector":"未分类","subIndustry":"","color":"","core":true,"importance":0,"publishDate":"","val":4,"_logicRefs":[],"_indicators":[],"_frameworks":[],"_relatedEntities":[]},{"id":"ent_feb33cc3e302","name":"Diamo8000","type":"PRODUCT","industry":"未分类","desc":"Diamo8000是半导体光刻检测设备或芯片测试设备，在测试速度和并行度方面具有竞争优势，为晶圆厂和芯片封装测试企业提供高效、高吞吐量的自动化检测解决方案。","is_core":false,"node_type":"entity","typeLabel":"PRODUCT","sector":"未分类","subIndustry":"","color":"