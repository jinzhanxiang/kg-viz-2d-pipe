c42\\u7684\\u4e2d\\u6027\\u548c\\u4e50\\u89c2\\u4e24\\u79cd\\u60c5\\u666f\\uff0c\\u6d4b\\u7b97\\u4f9b\\u9700\\u7f3a\\u53e3\\u7684\\u4e0d\\u540c\\u60c5\\u666f\", \"\\u6839\\u636e\\u4f9b\\u9700\\u7f3a\\u53e3\\u53d8\\u5316\\u8d8b\\u52bf\\u5224\\u65ad\\u4ef7\\u683c\\u8d70\\u52bf\\u548c\\u884c\\u4e1a\\u5468\\u671f\\u4f4d\\u7f6e\"]","confidence":0.8,"content":"框架名称：锂资源供需四象限分析框架\n描述：从供给端（海外盐湖、澳矿、海外锂矿、国内锂矿、国内盐湖、回收）和需求端（动力电池、储能电池、小型电池、传统行业）两个维度进行供需平衡预测，引入库存变量调整，计算供需缺口判断市场走势\n核心维度：供给预测, 需求预测, 供需缺口, 价格周期\n步骤：构建供给端分解模型，按地区和技术路线统计各主要矿山/盐湖的产能和产量预测, 构建需求端分解模型，按应用领域统计锂离子电池和传统行业的碳酸锂需求预测, 引入产业链2-4周备货库存变量，计算实际需求与供给的平衡关系, 设置储能需求的中性和乐观两种情景，测算供需缺口的不同情景, 根据供需缺口变化趋势判断价格走势和行业周期位置","is_core":true,"node_type":"framework"},{"id":"fw_fw_236cfdd481094103","name":"全球锂资源供给六分法","type":"methodology","category":"行业分析","industry":"有色金属","steps":"[\"\\u6d77\\u5916\\u76d0\\u6e56\\u677f\\u5757\\u5206\\u6790\\uff1a\\u963f\\u6839\\u5ef7\\u65b0\\u5efa\\u9879\\u76ee\\u722c\\u5761\\u8fdb\\u5ea6\\u3001\\u667a\\u5229SQM\\u548c\\u96c5\\u4fdd\\u6269\\u4ea7\\u8ba1\\u5212\\u3001\\u5df4\\u897f\\u9879\\u76ee\", \"\\u6fb3\\u77ff\\u677f\\u5757\\u5206\\u6790\\uff1aGreenbushes\\u3001Pilgangoora\\u7b49\\u4e3b\\u8981\\u77ff\\u5c71\\u589e\\u91cf\\u9884\\u6d4b\\u3001\\u505c\\u4ea7\\u77ff\\u5c71\\u5f71\\u54cd\", \"\\u975e\\u6d32\\u9502\\u77ff\\u677f\\u5757\\u5206\\u6790\\uff1a\\u4e2d\\u8d44\\u4f01\\u4e1a\\u5728\\u975e\\u9879\\u76ee\\u6295\\u4ea7\\u8fdb\\u5ea6\\u3001\\u6d25\\u5df4\\u5e03\\u97e6\\u548c\\u5c3c\\u65e5\\u5229\\u4e9a\\u8fdb\\u53e3\\u6570\\u636e\", \"\\u56fd\\u5185\\u9502\\u77ff\\u677f\\u5757\\u5206\\u6790\\uff1a\\u6c5f\\u897f\\u77ff\\u8bc1\\u6270\\u52a8\\u3001\\u56db\\u5ddd\\u7532\\u57fa\\u5361\\u548c\\u674e\\u5bb6\\u6c9f\\u3001\\u65b0\\u7586\\u5927\\u7ea2\\u67f3\\u6ee9\\u6295\\u4ea7\", \"\\u56fd\\u5185\\u76d0\\u6e56\\u677f\\u5757\\u5206\\u6790\\uff1a\\u9752\\u6d77\\u5bdf\\u5c14\\u6c57\\u76d0\\u6e56\\u5404\\u4f01\\u4e1a\\u3001\\u897f\\u85cf\\u5404\\u76d0\\u6e56\\u9879\\u76ee\\u89c4\\u5212\\u548c\\u5728\\u5efa\\u8fdb\\u5ea6\", \"\\u56de\\u6536\\u677f\\u5757\\u5206\\u6790\\uff1a\\u5e9f\\u6599\\u56de\\u6536\\u4ea7\\u80fd\\u589e\\u957f\\u5bf9\\u4f9b\\u7ed9\\u7684\\u8865\\u5145\\u4f5c\\u7528\"]","confidence":0.8,"content":"框架名称：全球锂资源供给六分法\n描述：将全球锂资源供给来源分为六大板块进行详细分析和预测：海外盐湖（阿根廷、智利）、澳矿、非洲锂矿、南美其他、 国内锂矿（江西宜春、四川、新疆）、国内盐湖（青海、西藏），评估各板块的增量释放节奏和贡献度\n核心维度：海外盐湖, 澳矿, 非洲锂矿, 国内锂矿, 国内盐湖, 回收\n步骤：海外盐湖板块分析：阿根廷新建项目爬坡进度、智利SQM和雅保扩产计划、巴西项目, 澳矿板块分析：Greenbushes、Pilgangoora等主要矿山增量预测、停产矿山影响, 非洲锂矿板块分析：中资企业在非项目投产进度、津巴布韦和尼日利亚进口数据, 国内锂矿板块分析：江西矿证扰动、四川甲基卡和李家沟、新疆大红柳滩投产, 国内盐湖板块分析：青海察尔汗盐湖各企业、西藏各盐湖项目规划和在建进度, 回收板块分析：废料回收产能增长对供给的补充作用","is_core":true,"node_type":"framework"},{"id":"fw_fw_539d566c24844dfa","name":"锂行业周期拐点识别框架","type":"risk","category":"财务分析","industry":"有色金属","steps":"[\"\\u4f9b\\u7ed9\\u7aef\\u51fa\\u6e05\\u4fe1\\u53f7\\uff1a\\u9ad8\\u6210\\u672c\\u77ff\\u5c71\\u505c\\u4ea7\\u3001\\u4f4e\\u4ef7\\u65e0\\u6cd5\\u523a\\u6fc0\\u989d\\u5916\\u4f9b\\u7ed9\\u3001\\u5730\\u7f18\\u653f\\u6cbb\\u5e72\\u6270\\u6d77\\u5916\\u9879\\u76ee\", \"\\u4f9b\\u9700\\u8fb9\\u9645\\u53d8\\u5316\\uff1a\\u8fc7\\u5269\\u6536\\u7a84\\u81f3\\u7d27\\u5e73\\u8861\\u751a\\u81f3\\u77ed\\u7f3a\\uff0c\\u5e93\\u5b58\\u6301\\u7eed\\u53bb\\u531618\\u5468\", \"\\u4ef7\\u683c\\u652f\\u6491\\u56e0\\u7d20\\uff1a\\u6c5f\\u897f\\u77ff\\u8bc1\\u6270\\u52a8\\u77ed\\u671f\\u4f9b\\u7ed9\\u3001\\u4e0b\\u6e38\\u6392\\u4ea7\\u73af\\u6bd4\\u63d0\\u5347\", \"\\u9700\\u6c42\\u589e\\u901f\\u4e0a\\u4fee\\uff1a\\u52a8\\u529b\\u7a33\\u6b65\\u589e\\u957f\\u53e0\\u52a0\\u50a8\\u80fd\\u7206\\u53d1\\u5f0f\\u589e\\u957f\\uff0c\\u7ec8\\u7aef\\u9700\\u6c42\\u589e\\u901f\\u5927\\u5e45\\u4e0a\\u8c03\", \"\\u5468\\u671f\\u6027\\u62d0\\u70b9\\u786e\\u8ba4\\uff1a\\u4f9b\\u7ed9\\u589e\\u91cf\\u6709\\u9650\\u4e0e\\u9700\\u6c42\\u65fa\\u76db\\u7684\\u683c\\u5c40\\u4e0b\\uff0c\\u884c\\u4e1a\\u5468\\u671f\\u6027\\u62d0\\u70b9\\u6216\\u5df2\\u5230\\u6765\"]","confidence":0.8,"content":"框架名称：锂行业周期拐点识别框架\n描述：综合供给端高成本项目出清、供需基本面改善、政策扰动等因素，判断锂行业周期拐点是否到来，分析新一轮周期的特征和投资机会\n核心维度：供给出清, 供需改善, 价格支撑, 拐点确认\n步骤：供给端出清信号：高成本矿山停产、低价无法刺激额外供给、地缘政治干扰海外项目, 供需边际变化：过剩收窄至紧平衡甚至短缺，库存持续去化18周, 价格支撑因素：江西矿证扰动短期供给、下游排产环比提升, 需求增速上修：动力稳步增长叠加储能爆发式增长，终端需求增速大幅上调, 周期性拐点确认：供给增量有限与需求旺盛的格局下，行业周期性拐点或已到来","is_core":true,"node_type":"framework"},{"id":"fw_fw_f304199b260944a6","name":"锂行业投资标的评估体系","type":"opportunity","category":"财务分析","industry":"有色金属","steps":"[\"\\u4ea7\\u80fd\\u589e\\u91cf\\u8bc4\\u4f30\\uff1a\\u5404\\u516c\\u53f82025-2026\\u5e74\\u9884\\u8ba1\\u8d21\\u732e\\u7684\\u9502\\u8d44\\u6e90\\u4ea7\\u91cf\\u589e\\u91cf\", \"\\u8d44\\u6e90\\u7980\\u8d4b\\u5206\\u6790\\uff1a\\u62e5\\u6709\\u7684\\u77ff\\u5c71\\u8d44\\u6e90\\u91cf\\u3001\\u54c1\\u5473\\u3001\\u5f00\\u91c7\\u6761\\u4ef6\\u7b49\\u6838\\u5fc3\\u6307\\u6807\", \"\\u6210\\u672c\\u7ade\\u4e89\\u529b\\uff1a\\u9ad8\\u6210\\u672c\\u9879\\u76ee\\u51fa\\u6e05\\u80cc\\u666f\\u4e0b\\uff0c\\u4f4e\\u6210\\u672c\\u4f18\\u52bf\\u4f01\\u4e1a\\u7684\\u9632\\u5fa1\\u6027\", \"\\u4e1a\\u7ee9\\u5f39\\u6027\\u6d4b\\u7b97\\uff1a\\u5047\\u8bbe\\u9502\\u4ef7\\u53cd\\u5f39\\u60c5\\u666f\\u4e0b\\uff0c\\u5404\\u516c\\u53f8\\u4e1a\\u7ee9\\u589e\\u539a\\u5e45\\u5ea6\", \"\\u98ce\\u9669\\u56e0\\u7d20\\u8bc6\\u522b\\uff1a\\u4e0b\\u6e38\\u9700\\u6c42\\u4e0d\\u53ca\\u9884\\u671f\\u3001\\u4f9b\\u7ed9\\u7aef\\u91ca\\u653e\\u8d85\\u9884\\u671f\\u3001\\u5730\\u7f18\\u653f\\u6cbb\\u51b2\\u7a81\"]","confidence":0.8,"content":"框架名称：锂行业投资标的评估体系\n描述：在新一轮周期中筛选增量明显、业绩弹性较大的投资标的，评估标准包括资源禀赋、产能扩张节奏、成本优势、业绩弹性等因素\n核心维度：产能增量, 资源禀赋, 成本优势, 业绩弹性\n步骤：产能增量评估：各公司2025-2026年预计贡献的锂资源产量增量, 资源禀赋分析：拥有的矿山资源量、品味、开采条件等核心指标, 成本竞争力：高成本项目出清背景下，低成本优势企业的防御性, 业绩弹性测算：假设锂价反弹情景下，各公司业绩增厚幅度, 风险因素识别：下游需求不及预期、供给端释放超预期、地缘政治冲突","is_core":true,"node_type":"framework"},{"id":"fw_fw_d11443a1773949f0","name":"锂资源开发分析框架","type":"core_architecture","category":"财务分析","industry":"有色金属","steps":"[\"1. \\u7edf\\u8ba1\\u5404\\u533a\\u57df\\u8d44\\u6e90\\u50a8\\u91cf\\u53ca\\u54c1\\u4f4d\\u6570\\u636e\", \"2. \\u5206\\u6790\\u73b0\\u6709\\u4ea7\\u80fd\\u5229\\u7528\\u7387\\u53ca\\u5728\\u5efa\\u9879\\u76ee\\u8fdb\\u5ea6\", \"3. \\u8bc4\\u4f30\\u653f\\u7b56\\u5ba1\\u6279\\u5bf9\\u4ea7\\u80fd\\u91ca\\u653e\\u7684\\u5f71\\u54cd\", \"4. \\u5bf9\\u6bd4\\u4e0d\\u540c\\u6280\\u672f\\u8def\\u7ebf\\u7684\\u6210\\u672c\\u66f2\\u7ebf\"]","confidence":0.8,"content":"框架名称：锂资源开发分析框架\n描述：通过资源储量、产能利用率、政策审批、技术路线四维度评估锂资源开发潜力。资源储量决定长期供给上限，产能利用率反映短期供给弹性，政策审批影响项目落地速度，技术路线决定成本结构。以江西宜春锂云母、四川锂辉石、青海盐湖为例，分析各区域开发进度差异。\n核心维度：资源储量, 产能利用率, 政策审批, 技术路线\n步骤：1. 统计各区域资源储量及品位数据, 2. 分析现有产能利用率及在建项目进度, 3. 评估政策审批对产能释放的影响, 4. 对比不同技术路线的成本曲线","is_core":true,"node_type":"framework"},{"id":"fw_fw_7bbf9ff09be34554","name":"锂市场平衡分析框架","type":"methodology","category":"行业分析","industry":"有色金属","steps":"[\"1. \\u8bbe\\u5b9a\\u4e2d\\u6027/\\u4e50\\u89c2\\u60c5\\u666f\\u53c2\\u6570\", \"2. \\u8ba1\\u7b97\\u5404\\u60c5\\u666f\\u4e0b\\u4f9b\\u9700\\u589e\\u91cf\", \"3. \\u5206\\u6790\\u5e93\\u5b58\\u53d8\\u5316\\u9a8c\\u8bc1\\u6a21\\u578b\", \"4. \\u8f93\\u51fa\\u5e73\\u8861\\u72b6\\u6001\\u7ed3\\u8bba\"]","confidence":0.8,"content":"框架名称：锂市场平衡分析框架\n描述：采用中性/乐观双情景假设进行供需平衡测算。中性假设下储能需求按50%增速预测，乐观假设下储能需求按70%增速预测。通过供给增量与需求增量的差值判断市场平衡状态，结合库存变化验证模型准确性。\n核心维度：情景假设, 供需增量, 库存验证\n步骤：1. 设定中性/乐观情景参数, 2. 计算各情景下供需增量, 3. 分析库存变化验证模型, 4. 输出平衡状态结论","is_core":true,"node_type":"framework"},{"id":"fw_fw_6115377e05e84ff8","name":"薄膜电容器产业链纵向整合分析","type":"opportunity","category":"财务分析","industry":"有色金属","steps":"[\"1. \\u68b3\\u7406\\u8584\\u819c\\u7535\\u5bb9\\u5668\\u4ea7\\u4e1a\\u94fe\\u7ed3\\u6784\\uff08\\u4e0a\\u6e38\\u91d1\\u5c5e\\u5316\\u8584\\u819c\\u3001\\u4e2d\\u6e38\\u7535\\u5bb9\\u5668\\u5236\\u9020\\u3001\\u4e0b\\u6e38\\u5e94\\u7528\\uff09\", \"2. \\u8bc4\\u4f30\\u91d1\\u5c5e\\u5316\\u8584\\u819c\\u5bf9\\u7535\\u5bb9\\u5668\\u6027\\u80fd\\u548c\\u6210\\u672c\\u7684\\u5f71\\u54cd\", \"3. \\u5206\\u6790\\u52df\\u6295\\u9879\\u76ee\\u8fbe\\u4ea7\\u540e\\u7684\\u4ea7\\u4e1a\\u94fe\\u534f\\u540c\\u6548\\u5e94\", \"4. \\u6d4b\\u7b97\\u52df\\u6295\\u9879\\u76ee\\u5bf9\\u6bdb\\u5229\\u7387\\u548c\\u51c0\\u5229\\u7387\\u7684\\u63d0\\u5347\\u7a7a\\u95f4\"]","confidence":0.8,"content":"框架名称：薄膜电容器产业链纵向整合分析\n描述：分析薄膜电容器产业链上下游关系，评估公司募投项目向产业链上游延伸（金属化薄膜自主生产）对成本控制、供应链安全、产能扩张的重要意义\n核心维度：上游原材料, 中游制造, 下游应用, 纵向整合\n步骤：1. 梳理薄膜电容器产业链结构（上游金属化薄膜、中游电容器制造、下游应用）, 2. 评估金属化薄膜对电容器性能和成本的影响, 3. 分析募投项目达产后的产业链协同效应, 4. 测算募投项目对毛利率和净利率的提升空间","is_core":true,"node_type":"framework"},{"id":"fw_fw_b6253d3ba799","name":"有色金属价格驱动因子分析框架","type":"core_architecture","category":"行业分析","industry":"有色金属","steps":"[\"\\u5206\\u6790\\u5b8f\\u89c2\\u6d41\\u52a8\\u6027\\u4e0e\\u6c47\\u7387\\u73af\\u5883\\u5bf9\\u8d35\\u91d1\\u5c5e\\u53ca\\u57fa\\u672c\\u91d1\\u5c5e\\u7684\\u4f30\\u503c\\u5f71\\u54cd\", \"\\u8bc4\\u4f30\\u5404\\u54c1\\u79cd\\u4f9b\\u9700\\u5e73\\u8861\\u8868\\uff0c\\u5305\\u62ec\\u4ea7\\u91cf\\u53d8\\u5316\\u3001\\u5e93\\u5b58\\u53bb\\u5316\\u901f\\u5ea6\\u53ca\\u653f\\u7b56\\u5bf9\\u4f9b\\u7ed9\\u7684\\u6270\\u52a8\", \"\\u7ed3\\u5408\\u5e02\\u573a\\u60c5\\u7eea\\u4e0e\\u8d44\\u91d1\\u6d41\\u5411\\uff0c\\u5224\\u65ad\\u77ed\\u671f\\u4ef7\\u683c\\u6ce2\\u52a8\\u65b9\\u5411\\u53ca\\u4e2d\\u957f\\u671f\\u8d8b\\u52bf\", \"\\u7efc\\u5408\\u4e0a\\u8ff0\\u56e0\\u7d20\\uff0c\\u7ed9\\u51fa\\u884c\\u4e1a\\u8bc4\\u7ea7\\u53ca\\u5177\\u4f53\\u54c1\\u79cd\\u7684\\u914d\\u7f6e\\u5efa\\u8bae\"]","confidence":0.8,"content":"框架名称：有色金属价格驱动因子分析框架\n描述：该框架通过宏观货币政策（降息预期、美元走势）、供需基本面（库存去化、产能限制、政策扰动）以及市场情绪（反内卷、ETF资金流向）三个维度，综合评估有色金属各细分品种的价格趋势。重点分析PCE数据、废铜政策、稀土管理条例等关键变量对价格中枢的影响，从而得出板块超配或低配的建议。\n适用场景：有色金属行业周期判断与板块配置建议\n核心维度：宏观流动性, 供需基本面, 市场情绪\n步骤：分析宏观流动性与汇率环境对贵金属及基本金属的估值影响, 评估各品种供需平衡表，包括产量变化、库存去化速度及政策对供给的扰动, 结合市场情绪与资金流向，判断短期价格波动方向及中长期趋势, 综合上述因素，给出行业评级及具体品种的配置建议","is_core":true,"node_type":"framework"}],"_relatedEntities":[],"_reports":[{"report_id":"rpt_11efaeb32147","title":"深度报告-华福证券-锂行业深度报告_储能成为锂第二成长曲线加速修复供需平衡表_锂价底部已至反弹可期_42页","source":"券商研报","publish_date":"2025-12-31","industry":"有色金属/锂"},{"report_id":"rpt_42edd85ece8b","title":"通惠期货-碳酸锂产业链周度数据报告_碳酸锂期价仍受短期因素压制_9月仍可期待潜在利好驱动_23页_1mb","source":"券商研报","publish_date":"2025-08-29","industry":"有色金属/锂"},{"report_id":"rpt_ae4a4f99630c","title":"2026年全球储能发展趋势_混沌中寻找确定性_26页_2mb","source":"券商研报","publish_date":"2025-01-20","industry":"电力设备/储能"}]}]